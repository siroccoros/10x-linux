+/* The DOS name of a font file. Converting a Unix path stats it and then each
+ * parent directory until one is a drive root, ~6 calls per font (~4 ms for
+ * 1100 fonts); fonts come grouped by directory, so the DOS name of the last
+ * directory is kept and only the file itself is checked. The memo is freed by
+ * passing NULL. */
+static WCHAR *get_font_dos_name( const char *unix_name )
+{
+    static char *memo_dir;
+    static WCHAR *memo_dos;
+    const char *slash;
+    unsigned int dir_len, base_len, len;
+    struct stat st;
+    WCHAR *ret;
+
+    if (!unix_name)
+    {
+        free( memo_dir );
+        free( memo_dos );
+        memo_dir = NULL;
+        memo_dos = NULL;
+        return NULL;
+    }
+
+    /* the file itself, and anything collapse_path() could change, the slow way */
+    slash = strrchr( unix_name, '/' );
+    if (!slash || slash == unix_name || strchr( slash, '\\' ) || slash[1] == '.' ||
+        stat( unix_name, &st ) || S_ISDIR( st.st_mode ))
+        goto slow;
+
+    dir_len = slash - unix_name;
+    if (!memo_dir || strlen( memo_dir ) != dir_len || memcmp( memo_dir, unix_name, dir_len ))
+    {
+        free( memo_dir );
+        free( memo_dos );
+        memo_dos = NULL;
+        if (!(memo_dir = malloc( dir_len + 1 ))) goto slow;
+        memcpy( memo_dir, unix_name, dir_len );
+        memo_dir[dir_len] = 0;
+        ntdll_get_dos_file_name( memo_dir, &memo_dos, FILE_OPEN );
+    }
+    /* only a name on a drive; a \\unix\ fallback is left to the slow way */
+    if (!memo_dos || memo_dos[1] != ':') goto slow;
+
+    len = wcslen( memo_dos );
+    base_len = strlen( slash + 1 );
+    if (!(ret = malloc( (len + base_len + 2) * sizeof(WCHAR) ))) goto slow;
+    memcpy( ret, memo_dos, len * sizeof(WCHAR) );
+    if (ret[len - 1] != '\\') ret[len++] = '\\';
+    len += ntdll_umbstowcs( slash + 1, base_len, ret + len, base_len );
+    ret[len] = 0;
+    return ret;
+
+slow:
+    ret = NULL;
+    ntdll_get_dos_file_name( unix_name, &ret, FILE_OPEN );
+    return ret;
+}
