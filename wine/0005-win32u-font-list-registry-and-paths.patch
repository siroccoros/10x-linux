+/* The names load_registry_fonts() finds in the Fonts key, kept in the volatile
+ * font cache key. The Fonts key lists every font (~1150 on a typical system)
+ * and enumerating it costs each process that loads the font list a server
+ * call per entry (~7 ms), though nearly all are fonts already loaded. The
+ * list is used only while the key's last write time, value count and maximum
+ * name and data lengths match those read before it was recorded, so any change
+ * to the key since makes the next process enumerate it again. */
+
+struct reg_font_names
+{
+    LARGE_INTEGER last_write;
+    ULONG values, max_name, max_data, win9x;
+    ULONG count;
+    /* count times: ULONG type, ULONG name length in bytes, name (not terminated) */
+};
+
+static const WCHAR reg_font_names_valueW[] = {'R','e','g','i','s','t','r','y','F','o','n','t','s',0};
+
+static BOOL get_reg_font_names_stamp( HKEY hkey, struct reg_font_names *stamp )
+{
+    char buffer[sizeof(KEY_FULL_INFORMATION) + 256];
+    KEY_FULL_INFORMATION *info = (KEY_FULL_INFORMATION *)buffer;
+    ULONG size;
+
+    if (NtQueryKey( hkey, KeyFullInformation, info, sizeof(buffer), &size )) return FALSE;
+    memset( stamp, 0, sizeof(*stamp) );
+    stamp->last_write = info->LastWriteTime;
+    stamp->values = info->Values;
+    stamp->max_name = info->MaxValueNameLen;
+    stamp->max_data = info->MaxValueDataLen;
+    stamp->win9x = is_win9x();
+    return TRUE;
+}
+
+/* returns the recorded list if it matches stamp, to be freed by the caller */
+static struct reg_font_names *load_reg_font_names( const struct reg_font_names *stamp, ULONG *size )
+{
+    KEY_VALUE_PARTIAL_INFORMATION *info;
+    struct reg_font_names *names;
+    ULONG len = FIELD_OFFSET( KEY_VALUE_PARTIAL_INFORMATION, Data[sizeof(*names)] ) +
+                stamp->values * (2 * sizeof(ULONG) + stamp->max_name);
+
+    if (!wine_fonts_cache_key || !(info = malloc( len ))) return NULL;
+    if (!(len = query_reg_value( wine_fonts_cache_key, reg_font_names_valueW, info, len )) ||
+        info->Type != REG_BINARY || len < sizeof(*names) ||
+        memcmp( info->Data, stamp, offsetof( struct reg_font_names, count )))
+    {
+        free( info );
+        return NULL;
+    }
+    names = (struct reg_font_names *)info;
+    memmove( names, info->Data, len );
+    *size = len;
+    return names;
+}
+
+static void save_reg_font_names( const void *data, ULONG size )
+{
+    if (wine_fonts_cache_key) set_reg_value( wine_fonts_cache_key, reg_font_names_valueW, REG_BINARY, data, size );
+}
