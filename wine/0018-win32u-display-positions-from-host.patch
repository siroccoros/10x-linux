+static BOOL is_same_mode( const DEVMODEW *a, const DEVMODEW *b )
+{
+    static const UINT fields[] = {DM_DISPLAYORIENTATION, DM_BITSPERPEL, DM_PELSWIDTH, DM_PELSHEIGHT, DM_DISPLAYFREQUENCY};
+    POINTL pos_a = {0}, pos_b = {0};
+    UINT i;
+
+    for (i = 0; i < ARRAY_SIZE(fields); i++)
+        if (devmode_get( a, fields[i] ) != devmode_get( b, fields[i] )) return FALSE;
+    if (a->dmFields & DM_POSITION) pos_a = a->dmPosition;
+    if (b->dmFields & DM_POSITION) pos_b = b->dmPosition;
+    return pos_a.x == pos_b.x && pos_a.y == pos_b.y;
+}
