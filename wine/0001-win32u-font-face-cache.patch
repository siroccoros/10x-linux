+
 static struct unix_face *unix_face_create( const char *unix_name, void *data_ptr, UINT data_size,
                                            UINT face_index, UINT flags )
 {
+    UINT allow_bitmap = !!(flags & ADDFONT_ALLOW_BITMAP);
+    struct face_cache_entry *entry;
+    struct face_cache_key key;
+    struct unix_face *This;
+    WCHAR *names[4] = { 0 };
+    struct stat st;
+    int i;
+
+    if (!unix_name) return unix_face_create_uncached( NULL, data_ptr, data_size, face_index, flags, NULL );
+    if (stat( unix_name, &st )) return NULL;
+    face_cache_set_key( &key, &st );
+
+    pthread_mutex_lock( &face_cache_lock );
+    if (!face_cache_loaded) face_cache_load();
+    if ((entry = face_cache_find( unix_name, face_index, allow_bitmap )) &&
+        !memcmp( &entry->key, &key, sizeof(key) ))
+    {
+        entry->used = TRUE;
+        face_cache_hits++;
+        This = NULL;
+        if (entry->valid && (This = calloc( 1, sizeof(*This) )))
+        {
+            This->scalable = entry->scalable;
+            This->num_faces = entry->num_faces;
+            This->family_name = face_cache_dup_name( entry->names[0] );
+            This->second_name = face_cache_dup_name( entry->names[1] );
+            This->style_name = face_cache_dup_name( entry->names[2] );
+            This->full_name = face_cache_dup_name( entry->names[3] );
+            This->ntm_flags = entry->ntm_flags;
+            This->weight = entry->weight;
+            This->font_version = entry->font_version;
+            This->fs = entry->fs;
+            This->size = entry->size;
+        }
+        pthread_mutex_unlock( &face_cache_lock );
+        return This;
+    }
+    face_cache_misses++;
+    pthread_mutex_unlock( &face_cache_lock );
+
+    This = unix_face_create_uncached( unix_name, NULL, 0, face_index, flags, &st );
+    if (!st.st_ino && !st.st_dev) return This; /* couldn't read it; don't remember that */
+    face_cache_set_key( &key, &st );
+
+    if (This)
+    {
+        names[0] = face_cache_dup_name( This->family_name );
+        names[1] = face_cache_dup_name( This->second_name );
+        names[2] = face_cache_dup_name( This->style_name );
+        names[3] = face_cache_dup_name( This->full_name );
+        if (!names[0] != !This->family_name || !names[1] != !This->second_name ||
+            !names[2] != !This->style_name || !names[3] != !This->full_name)
+        {
+            for (i = 0; i < ARRAY_SIZE(names); i++) free( names[i] );
+            return This;
+        }
+    }
+
+    pthread_mutex_lock( &face_cache_lock );
+    if (!face_cache_path) entry = NULL;
+    else if (!(entry = face_cache_find( unix_name, face_index, allow_bitmap )))
+        entry = face_cache_add( unix_name, face_index, allow_bitmap );
+    if (entry)
+    {
+        face_cache_free_names( entry );
+        entry->key = key;
+        entry->used = TRUE;
+        entry->valid = This != NULL;
+        entry->scalable = This ? This->scalable : FALSE;
+        entry->num_faces = This ? This->num_faces : 0;
+        entry->ntm_flags = This ? This->ntm_flags : 0;
+        entry->weight = This ? This->weight : 0;
+        entry->font_version = This ? This->font_version : 0;
+        if (This) entry->fs = This->fs;
+        else memset( &entry->fs, 0, sizeof(entry->fs) );
+        if (This) entry->size = This->size;
+        else memset( &entry->size, 0, sizeof(entry->size) );
+        memcpy( entry->names, names, sizeof(names) );
+        face_cache_dirty = TRUE;
+    }
+    else for (i = 0; i < ARRAY_SIZE(names); i++) free( names[i] );
+    pthread_mutex_unlock( &face_cache_lock );
+    return This;
+}
