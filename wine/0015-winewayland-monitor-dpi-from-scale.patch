+/* A monitor's DPI is its scale, as on Windows: the compositor's logical size
+ * of the output is its mode size divided by the scale. */
+static UINT output_dpi(struct wayland_output_state *output)
+{
+    int mode_size = max(output->current_mode->width, output->current_mode->height);
+    int logical_size = max(output->logical_w, output->logical_h);
+
+    if (!logical_size) return USER_DEFAULT_SCREEN_DPI;
+    return round(USER_DEFAULT_SCREEN_DPI * mode_size / (double)logical_size);
+}
