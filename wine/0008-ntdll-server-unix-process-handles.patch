+    struct pipe_bridge *bridge, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE( bridge, next, &pipe_end->bridges, struct pipe_bridge, entry )
+    {
+        if (bridge->to_unix) pipe_bridge_write( bridge );
+        else pipe_bridge_update( bridge );
+    }
+}
