+/* A Unix program started by a Windows one (see fork_and_exec in ntdll). It has
+ * no Wine threads, so it is tracked through a pidfd: it gets a process id, its
+ * handle is signaled when it exits, and it reports its exit status as the exit
+ * code (128 + the signal number if a signal killed it, as shells report it). */
+struct unix_process
+{
+    struct object        obj;          /* object header */
+    struct object       *sync;         /* sync object for wait/signal */
+    struct fd           *fd;           /* pidfd */
+    struct timeout_user *timeout;      /* waiting for the exit status */
+    timeout_t            retry;        /* delay before asking for it again */
+    process_id_t         id;           /* id of the process */
+    process_id_t         parent_id;    /* id of the process that started it */
+    int                  exit_code;    /* exit code, STILL_ACTIVE while running */
+    int                  terminated;   /* exit code set by TerminateProcess */
+    timeout_t            start_time;   /* absolute time at process start */
+    timeout_t            end_time;     /* absolute time at process end */
+};
