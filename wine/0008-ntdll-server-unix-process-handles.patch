+static void unix_process_dump( struct object *obj, int verbose );
+static struct object *unix_process_get_sync( struct object *obj );
+static void unix_process_destroy( struct object *obj );
+static void unix_process_poll_event( struct fd *fd, int event );
+
+static const struct object_ops unix_process_ops =
+{
+    .size       = sizeof(struct unix_process),
+    .type       = &process_type,
+    .dump       = unix_process_dump,
+    .get_sync   = unix_process_get_sync,
+    .map_access = process_map_access,
+    .get_sd     = process_get_sd,
+    .destroy    = unix_process_destroy,
+};
+
+static const struct fd_ops unix_process_fd_ops =
+{
+    .poll_event = unix_process_poll_event,
+};
+
+static void unix_process_dump( struct object *obj, int verbose )
+{
+    struct unix_process *process = (struct unix_process *)obj;
+    assert( obj->ops == &unix_process_ops );
+    fprintf( stderr, "Unix process id=%04x exit_code=%d\n", process->id, process->exit_code );
+}
+
+static struct object *unix_process_get_sync( struct object *obj )
+{
+    struct unix_process *process = (struct unix_process *)obj;
+    assert( obj->ops == &unix_process_ops );
+    return grab_object( process->sync );
+}
+
+static void unix_process_destroy( struct object *obj )
+{
+    struct unix_process *process = (struct unix_process *)obj;
+    assert( obj->ops == &unix_process_ops );
+
+    if (process->timeout) remove_timeout_user( process->timeout );
+    if (process->fd) release_object( process->fd );
+    if (process->id) free_ptid( process->id );
+    if (process->sync) release_object( process->sync );
