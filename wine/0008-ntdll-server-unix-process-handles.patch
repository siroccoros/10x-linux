+/* We call async_terminate in our reselect implementation, which causes recursive reselect.
+ * We're not interested in such reselect calls, so we ignore them. */
+static int ignore_reselect;
+
+/* data a bridge queues for the reader before it waits for it to read */
+#define PIPE_BRIDGE_BUFFER 65536
+
+static void pipe_bridge_dump( struct object *obj, int verbose )
+{
+    struct pipe_bridge *bridge = (struct pipe_bridge *)obj;
+    assert( obj->ops == &pipe_bridge_ops );
+    fprintf( stderr, "Pipe bridge fd=%p %s\n", bridge->fd, bridge->to_unix ? "to Unix" : "from Unix" );
+}
+
+static void pipe_bridge_destroy( struct object *obj )
+{
+    struct pipe_bridge *bridge = (struct pipe_bridge *)obj;
+    assert( obj->ops == &pipe_bridge_ops );
+    if (bridge->closing) remove_timeout_user( bridge->closing );
+    if (bridge->fd) release_object( bridge->fd );
+}
+
+static void pipe_bridge_close( struct pipe_bridge *bridge )
+{
+    struct pipe_end *pipe_end = bridge->pipe_end;
+
+    if (!pipe_end) return;
+    bridge->pipe_end = NULL;
+    list_remove( &bridge->entry );
+    release_object( bridge->fd );  /* the program sees the end of its input, or a broken pipe */
+    bridge->fd = NULL;
+    release_object( pipe_end );
+    release_object( bridge );
+}
+
+static void pipe_bridge_closing( void *private )
+{
+    struct pipe_bridge *bridge = private;
+
+    bridge->closing = NULL;
+    pipe_bridge_close( bridge );
+}
+
+/* close the bridge once the pipe operation in progress is done with the pipe end */
+static void pipe_bridge_finish( struct pipe_bridge *bridge )
+{
+    if (bridge->closing || !bridge->pipe_end) return;
+    set_fd_events( bridge->fd, -1 );
+    bridge->closing = add_timeout_user( 0, pipe_bridge_closing, bridge );
+}
+
+/* read the program's output while the reader has room for it */
+static void pipe_bridge_update( struct pipe_bridge *bridge )
+{
+    struct pipe_end *reader;
+
+    if (bridge->closing || !bridge->pipe_end) return;
+    if (!(reader = bridge->pipe_end->connection))
+    {
+        pipe_bridge_finish( bridge );  /* nobody reads it any more */
+        return;
+    }
+    set_fd_events( bridge->fd, pipe_end_get_avail( reader ) < max( reader->buffer_size, PIPE_BRIDGE_BUFFER ) ? POLLIN : -1 );
+}
