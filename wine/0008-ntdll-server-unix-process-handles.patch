+/* write the messages queued on the pipe end into the program's input; returns
+ * whether any were written */
+static int pipe_bridge_write( struct pipe_bridge *bridge )
+{
+    struct pipe_end *pipe_end = bridge->pipe_end;
+    struct pipe_message *message;
+    data_size_t left;
+    ssize_t size;
+    int written = 0, reselecting;
+
+    if (bridge->closing || !pipe_end) return 0;
+    reselecting = ignore_reselect;
+    ignore_reselect = 1;  /* completing a write must not read the queue under us */
+    while (!list_empty( &pipe_end->message_queue ))
+    {
+        message = LIST_ENTRY( list_head(&pipe_end->message_queue), struct pipe_message, entry );
+        if ((left = message->iosb->in_size - message->read_pos))
+        {
+            size = write( get_unix_fd( bridge->fd ), (const char *)message->iosb->in_data + message->read_pos, left );
+            if (size == -1)
+            {
+                if (errno == EAGAIN || errno == EINTR) set_fd_events( bridge->fd, POLLOUT );
+                else pipe_bridge_finish( bridge );  /* the program closed its input */
+                goto done;
+            }
+            message->read_pos += size;
+            written = 1;
+            if (size < left)
+            {
+                set_fd_events( bridge->fd, POLLOUT );
+                goto done;
+            }
+        }
+        wake_message( message, message->iosb->in_size );
+        free_message( message );
+        written = 1;
+    }
+    if (pipe_end->state != FILE_PIPE_CONNECTED_STATE) pipe_bridge_finish( bridge );  /* all of it was written */
+    else set_fd_events( bridge->fd, 0 );  /* only notice the program closing its input */
+done:
+    ignore_reselect = reselecting;
+    return written;
+}
+
+static void pipe_bridge_poll_event( struct fd *fd, int event )
+{
+    struct pipe_bridge *bridge = get_fd_user( fd );
+
+    if (!bridge->to_unix) pipe_bridge_read( bridge );
+    else if (event & (POLLERR | POLLHUP)) pipe_bridge_finish( bridge );
+    else
+    {
+        grab_object( bridge );
+        reselect_read_queue( bridge->pipe_end, 0 );
+        release_object( bridge );
+    }
+}
