+/* queue the program's output for the reader, as if written to the pipe end */
+static void pipe_bridge_read( struct pipe_bridge *bridge )
+{
+    struct pipe_end *reader = bridge->pipe_end->connection;
+    char buffer[PIPE_BRIDGE_BUFFER];
+    struct iosb *iosb;
+    ssize_t size;
+
+    if (!reader)
