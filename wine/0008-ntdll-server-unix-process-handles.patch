+ *           get_unix_stdio_fd
+ *
+ * Get the Unix fd a Unix program uses for a standard handle it was given.
+ * Pipes have no Unix fd: they get a Unix pipe that wineserver connects to them.
+ */
+static int get_unix_stdio_fd( HANDLE handle, int std_fd )
+{
+    int fd, pipefd[2], to_unix = !std_fd;
+    NTSTATUS status;
+
+    if (!handle) return -1;
+    if (!wine_server_handle_to_fd( handle, to_unix ? FILE_READ_DATA : FILE_WRITE_DATA, &fd, NULL ))
+        return fd;
+    if (isatty( std_fd ) && is_unix_console_handle( handle )) return std_fd;
+
+#ifdef HAVE_PIPE2
+    if (pipe2( pipefd, O_CLOEXEC ) == -1)
+#endif
+    {
+        if (pipe( pipefd ) == -1) return -1;
+        fcntl( pipefd[0], F_SETFD, FD_CLOEXEC );
+        fcntl( pipefd[1], F_SETFD, FD_CLOEXEC );
+    }
+    wine_server_send_fd( pipefd[to_unix] );
+    SERVER_START_REQ( set_pipe_unix_fd )
+    {
+        req->handle  = wine_server_obj_handle( handle );
+        req->fd      = pipefd[to_unix];
+        req->to_unix = to_unix;
+        status = wine_server_call( req );
+    }
+    SERVER_END_REQ;
+    close( pipefd[to_unix] );
+    if (!status) return pipefd[!to_unix];
+    close( pipefd[!to_unix] );
+    return -1;
+}
