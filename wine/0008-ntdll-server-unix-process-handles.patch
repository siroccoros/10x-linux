+static void register_unix_process( int pidfd, ACCESS_MASK process_access, ACCESS_MASK thread_access,
+                                   const OBJECT_ATTRIBUTES *process_attr, HANDLE *process, HANDLE *thread,
+                                   ULONG *process_id )
