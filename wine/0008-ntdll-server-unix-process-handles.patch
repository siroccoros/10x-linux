+    wine_server_send_fd( pidfd );
+    SERVER_START_REQ( new_unix_process )
+    {
+        req->pidfd         = pidfd;
+        req->access        = process_access;
+        req->thread_access = thread_access;
+        req->attributes    = process_attr ? process_attr->Attributes : 0;
+        if (!wine_server_call( req ))
+        {
+            *process    = wine_server_ptr_handle( reply->handle );
+            *thread     = wine_server_ptr_handle( reply->thread );
+            *process_id = reply->pid;
+        }
+    }
+    SERVER_END_REQ;
+}
