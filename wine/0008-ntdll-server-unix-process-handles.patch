+/* A pipe end given to a Unix program as its standard input or output (see
+ * fork_and_exec in ntdll): Wine's pipes have no Unix file descriptor, so the
+ * bridge moves the data between the pipe end and a Unix pipe, reading the pipe
+ * end's messages like ReadFile or queueing them like WriteFile. Like the
+ * program's handle on Windows, it holds the pipe end until the program closes
+ * its side. */
+struct pipe_bridge
+{
+    struct object        obj;        /* object header */
+    struct list          entry;      /* entry in the pipe end's bridges */
+    struct fd           *fd;         /* our end of the Unix pipe */
+    struct pipe_end     *pipe_end;   /* the pipe end, while the bridge is open */
+    int                  to_unix;    /* the program reads the pipe end */
+    struct timeout_user *closing;    /* closing outside of pipe operations */
+};
+
+static data_size_t pipe_end_get_avail( struct pipe_end *pipe_end );
+static void pipe_bridge_dump( struct object *obj, int verbose );
+static void pipe_bridge_destroy( struct object *obj );
+static void pipe_bridge_poll_event( struct fd *fd, int event );
+
+static const struct object_ops pipe_bridge_ops =
+{
+    .size    = sizeof(struct pipe_bridge),
+    .type    = &no_type,
+    .dump    = pipe_bridge_dump,
+    .destroy = pipe_bridge_destroy,
+};
+
+static const struct fd_ops pipe_bridge_fd_ops =
