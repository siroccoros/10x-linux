+#define PIDFD_GET_INFO _IOWR( 0xff, 11, struct pidfd_exit_info )
+#endif
+
+/* get the exit status once the program has exited and been reaped */
+static int get_unix_process_status( struct unix_process *process, int *status )
+{
+#ifdef PIDFD_GET_INFO
+    struct pidfd_exit_info info = { .mask = PIDFD_INFO_EXIT };
+
+    if (ioctl( get_unix_fd( process->fd ), PIDFD_GET_INFO, &info ) == -1)
+    {
