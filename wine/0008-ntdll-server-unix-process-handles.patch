+        pipe_bridge_finish( bridge );  /* the program closed its output */
+        return;
+    }
+    if (!(iosb = create_iosb( buffer, size, 0 ))) return;
+    if (!queue_message( reader, iosb )) clear_error();
+    release_object( iosb );
+    grab_object( bridge );
+    reselect_read_queue( reader, 0 );
+    pipe_bridge_update( bridge );
+    release_object( bridge );
