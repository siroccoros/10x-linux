+/* Each toplevel is exported (xdg-foreign) and the handle is kept as a global
+ * atom in a window property, so that a desktop portal dialog (comdlg32's file
+ * dialog) can be made a child of the window, as Windows dialogs are of their
+ * owner. */
+static const WCHAR foreign_handle_propW[] = {'_','_','w','i','n','e','_','x','d','g','_','f','o','r','e','i','g','n','_','h','a','n','d','l','e',0};
+
+static void exported_handle(void *data, struct zxdg_exported_v2 *exported, const char *handle)
+{
+    HWND hwnd = data;
+    WCHAR nameW[256];
+    RTL_ATOM atom;
+    DWORD i, len;
+
+    TRACE("hwnd=%p handle=%s\n", hwnd, debugstr_a(handle));
+
+    if ((len = strlen(handle)) >= ARRAY_SIZE(nameW)) return;
+    for (i = 0; i < len; i++) nameW[i] = (unsigned char)handle[i];
+    if (NtAddAtom(nameW, len * sizeof(WCHAR), &atom)) return;
+    if (!NtUserSetProp(hwnd, foreign_handle_propW, UlongToHandle(atom))) NtDeleteAtom(atom);
+}
+
+static const struct zxdg_exported_v2_listener exported_listener =
+{
+    exported_handle
+};
+
+static void wayland_surface_export_toplevel(struct wayland_surface *surface)
+{
+    if (!process_wayland.zxdg_exporter_v2) return;
+    surface->zxdg_exported_v2 =
+        zxdg_exporter_v2_export_toplevel(process_wayland.zxdg_exporter_v2, surface->wl_surface);
+    if (surface->zxdg_exported_v2)
+        zxdg_exported_v2_add_listener(surface->zxdg_exported_v2, &exported_listener, surface->hwnd);
+}
+
+static void wayland_surface_unexport_toplevel(struct wayland_surface *surface)
+{
+    HANDLE atom;
+
+    if (!surface->zxdg_exported_v2) return;
+    zxdg_exported_v2_destroy(surface->zxdg_exported_v2);
+    surface->zxdg_exported_v2 = NULL;
+    if ((atom = NtUserRemoveProp(surface->hwnd, foreign_handle_propW)))
+        NtDeleteAtom(HandleToUlong(atom));
+}
+
