+static UINT add_wineloader_paths( struct wineloader_path *paths, UINT count, char *loader )
+{
+    if (!loader) return count;
+#ifdef HAVE_WINE_PRELOADER
+    if (asprintf( &paths[count].path, "%s-preloader", loader ) != -1) paths[count++].loader = loader;
+#endif
+    paths[count].path = loader;
+    paths[count++].loader = NULL;
+    return count;
+}
+
+/***********************************************************************
+ *           get_wineloader_paths
+ *
+ * The programs exec_wineloader() tries, in order. A preloader is followed by
+ * its loader; the caller frees each path.
+ */
+UINT get_wineloader_paths( WORD machine, struct wineloader_path paths[4] )
+{
+    UINT count = add_wineloader_paths( paths, 0, get_alternate_wineloader( machine ));
+    return add_wineloader_paths( paths, count, strdup( wineloader ));
+}
