+static void *dnd_read_uri_list(int fd, size_t *ret_size)
+{
+    size_t total = 0, cap = 4096;
+    struct timespec now;
+    struct pollfd pfd = {.fd = fd, .events = POLLIN};
+    long long deadline;
+    char *buf, *tmp;
+    ssize_t n;
+
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    deadline = now.tv_sec * 1000LL + now.tv_nsec / 1000000 + DND_READ_TIMEOUT_MS;
+    if (!(buf = malloc(cap))) return NULL;
+    for (;;)
+    {
+        long long left;
+        int ret;
+
+        clock_gettime(CLOCK_MONOTONIC, &now);
+        left = deadline - (now.tv_sec * 1000LL + now.tv_nsec / 1000000);
+        ret = left > 0 ? poll(&pfd, 1, left) : 0;
+        if (ret == -1 && errno == EINTR) continue;
+        if (ret <= 0)
+        {
+            WARN("drag source didn't send its file list\n");
+            goto fail;
+        }
+        if (total == cap)
+        {
+            if (cap >= DND_MAX_LIST_SIZE || !(tmp = realloc(buf, cap * 2))) goto fail;
+            buf = tmp;
+            cap *= 2;
+        }
+        n = read(fd, buf + total, cap - total);
+        if (n == -1 && errno == EINTR) continue;
+        if (n == -1) goto fail;
+        if (n == 0) break;
+        total += n;
+    }
+    *ret_size = total;
+    return buf;
+
+fail:
+    free(buf);
+    return NULL;
+}
+
+static int hex_digit(char c)
+{
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+
+/* Returns the DOS path of a local file:// URI. */
+static WCHAR *dos_path_from_uri(const char *uri, size_t len)
+{
+    const char *s = uri + 5, *end = uri + len;
+    WCHAR *ret = NULL;
+    char *path, *p;
+
+    if (len <= 5 || strncmp(uri, "file:", 5)) return NULL;
+    /* file:///path, file://host/path for this host, or file:/path. */
+    if (end - s >= 2 && s[0] == '/' && s[1] == '/')
+    {
+        const char *host = s + 2, *slash = memchr(host, '/', end - host);
+        size_t host_len;
+        char hostname[256];
+
+        if (!slash) return NULL;
+        host_len = slash - host;
+        if (host_len && !(host_len == 9 && !strncmp(host, "localhost", 9)) &&
+            (gethostname(hostname, sizeof(hostname)) || strlen(hostname) != host_len ||
+             strncmp(hostname, host, host_len)))
+            return NULL;
+        s = slash;
+    }
+    if (s == end || *s != '/') return NULL;
+
+    if (!(path = p = malloc(end - s + 1))) return NULL;
+    for (; s < end; s++)
+    {
+        int hi, lo;
+
+        if (*s == '%' && end - s > 2 && (hi = hex_digit(s[1])) >= 0 && (lo = hex_digit(s[2])) >= 0)
+        {
+            /* %00 would cut the path short. */
+            if (!(*p++ = hi * 16 + lo)) goto done;
+            s += 2;
+        }
+        else *p++ = *s;
+    }
+    *p = 0;
+    ntdll_get_dos_file_name(path, &ret, FILE_OPEN);
+    TRACE("%s -> %s\n", debugstr_a(path), debugstr_w(ret));
+
+done:
+    free(path);
+    return ret;
+}
+
+/* Returns the CF_HDROP format entry for a text/uri-list. */
+static struct format_entry *dnd_entries_from_uri_list(const char *data, size_t size,
+                                                      size_t *ret_size)
+{
+    const char *line = data, *end = data + size;
+    size_t total = 0, cap = 1024, drop_size;
+    struct format_entry *entry = NULL;
+    WCHAR *files, *tmp, *path;
+    DROPFILES *drop;
+
+    if (!(files = malloc(cap * sizeof(WCHAR)))) return NULL;
+
+    while (line < end)
+    {
+        const char *eol = memchr(line, '\n', end - line);
+        size_t len = (eol ? eol : end) - line;
+
+        if (len && line[len - 1] == '\r') len--;
+        if (len && line[0] != '#' && (path = dos_path_from_uri(line, len)))
+        {
+            size_t path_len = wcslen(path) + 1;
+            if (total + path_len + 1 > cap)
+            {
+                cap = 2 * cap + path_len;
+                if (!(tmp = realloc(files, cap * sizeof(WCHAR))))
+                {
+                    free(path);
+                    break;
+                }
+                files = tmp;
+            }
+            memcpy(files + total, path, path_len * sizeof(WCHAR));
+            total += path_len;
+            free(path);
+        }
+        line = eol ? eol + 1 : end;
+    }
+
+    if (total)
+    {
+        files[total++] = 0;
+        drop_size = sizeof(*drop) + total * sizeof(WCHAR);
+        *ret_size = (offsetof(struct format_entry, data[drop_size]) + 7) & ~7;
+        if ((entry = calloc(1, *ret_size)))
+        {
+            entry->format = CF_HDROP;
+            entry->size = drop_size;
+            drop = (DROPFILES *)entry->data;
+            drop->pFiles = sizeof(*drop);
+            drop->fWide = TRUE;
+            memcpy(drop + 1, files, total * sizeof(WCHAR));
+        }
+    }
+    free(files);
+    return entry;
+}
