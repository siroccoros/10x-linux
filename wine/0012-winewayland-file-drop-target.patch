+static void dnd_enter(HWND hwnd, UINT gen)
+{
+    struct wayland_data_device *data_device = &process_wayland.data_device;
+    struct format_entry *entries = NULL;
+    size_t size, entries_size = 0;
+    UINT previous_gen = 0;
+    BOOL current;
+    char *list;
+    int fd = -1;
+
+    /* The drop may already have happened. */
+    pthread_mutex_lock(&data_device->mutex);
+    if (dnd.gen == gen && dnd.offer)
+        fd = wayland_data_offer_get_import_fd(dnd.offer, uri_list_mime);
+    else if (dnd.dropped_gen == gen && dnd.dropped_offer)
+        fd = wayland_data_offer_get_import_fd(dnd.dropped_offer, uri_list_mime);
+    pthread_mutex_unlock(&data_device->mutex);
+    if (fd < 0) return;
+
+    if ((list = dnd_read_uri_list(fd, &size)))
+    {
+        entries = dnd_entries_from_uri_list(list, size, &entries_size);
+        free(list);
+    }
+    close(fd);
+
+    pthread_mutex_lock(&data_device->mutex);
+    if ((current = dnd.gen == gen) && entries)
+    {
+        /* A window of another thread may not have seen its drag leave yet. */
+        previous_gen = dnd.entered_gen;
+        dnd.entered_gen = gen;
+    }
+    else if (current && dnd.offer) dnd_respond(FALSE);
+    pthread_mutex_unlock(&data_device->mutex);
+    if (!current || !entries) goto done;
+
+    if (previous_gen)
+        NtUserMessageCall(0, WINE_DRAG_DROP_LEAVE, 0, 0, NULL, NtUserDragDropCall, FALSE);
+    if (NtUserMessageCall(0, WINE_DRAG_DROP_ENTER, entries_size, (LPARAM)entries, NULL,
+                          NtUserDragDropCall, FALSE))
+    {
+        pthread_mutex_lock(&data_device->mutex);
+        if (dnd.entered_gen == gen) dnd.entered_gen = 0;
+        if (dnd.gen == gen && dnd.offer) dnd_respond(FALSE);
+        pthread_mutex_unlock(&data_device->mutex);
+        goto done;
+    }
+    dnd_motion(hwnd, gen);
+
+done:
+    free(entries);
+}
+
+static void dnd_leave(UINT gen)
+{
+    struct wayland_data_device *data_device = &process_wayland.data_device;
+    BOOL entered;
+
+    pthread_mutex_lock(&data_device->mutex);
+    if ((entered = dnd.entered_gen == gen)) dnd.entered_gen = 0;
+    pthread_mutex_unlock(&data_device->mutex);
+
+    if (entered) NtUserMessageCall(0, WINE_DRAG_DROP_LEAVE, 0, 0, NULL, NtUserDragDropCall, FALSE);
+}
