+static void dnd_drop(HWND hwnd, UINT gen)
+{
+    struct wayland_data_device *data_device = &process_wayland.data_device;
+    struct wayland_data_offer *data_offer = NULL;
+    DWORD effect = DROPEFFECT_NONE;
