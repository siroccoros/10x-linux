+/* The point in raw screen coordinates, like pointer motion. */
+static BOOL dnd_point(HWND hwnd, wl_fixed_t x_w, wl_fixed_t y_w, POINT *point)
+{
+    struct wayland_win_data *data;
+    struct wayland_surface *surface;
+    POINT pt = {wl_fixed_to_double(x_w), wl_fixed_to_double(y_w)};
+    RECT *rect;
+
+    if (!(data = wayland_win_data_get(hwnd))) return FALSE;
+    if (!(surface = data->wayland_surface))
+    {
+        wayland_win_data_release(data);
+        return FALSE;
+    }
+    rect = &surface->window.rect;
+    pt = map_point_from_surface(surface, pt);
+    point->x = min(max(pt.x + rect->left, rect->left), rect->right - 1);
+    point->y = min(max(pt.y + rect->top, rect->top), rect->bottom - 1);
+    wayland_win_data_release(data);
+    return TRUE;
+}
