+static void dnd_motion(HWND hwnd, UINT gen)
+{
+    struct wayland_data_device *data_device = &process_wayland.data_device;
+    DWORD effect = DROPEFFECT_NONE;
+    wl_fixed_t x_w, y_w;
+    POINT point = {0};
+
+    pthread_mutex_lock(&data_device->mutex);
+    if (dnd.gen != gen || dnd.entered_gen != gen)
+    {
+        pthread_mutex_unlock(&data_device->mutex);
+        return;
+    }
+    dnd.motion_posted = FALSE;
+    x_w = dnd.x;
+    y_w = dnd.y;
+    pthread_mutex_unlock(&data_device->mutex);
+
+    if (dnd_point(hwnd, x_w, y_w, &point))
+        effect = NtUserMessageCall(hwnd, WINE_DRAG_DROP_DRAG, MAKELONG(point.x, point.y),
+                                   DROPEFFECT_COPY, NULL, NtUserDragDropCall, FALSE);
+    TRACE("hwnd=%p point=%s effect=%#x\n", hwnd, wine_dbgstr_point(&point), (int)effect);
+
+    pthread_mutex_lock(&data_device->mutex);
+    if (dnd.gen == gen && dnd.offer) dnd_respond(effect != DROPEFFECT_NONE);
+    pthread_mutex_unlock(&data_device->mutex);
+}
