+/* The primary monitor's DPI as the display driver last reported it, which on
+ * Windows is the system DPI unless the user chose one. */
+UINT get_primary_monitor_dpi(void)
+{
+    static const UINT prefix_len = sizeof("\\Registry\\Machine");
+    char buffer[4096];
+    KEY_VALUE_PARTIAL_INFORMATION *value = (void *)buffer;
+    const WCHAR *value_str = (const WCHAR *)value->Data;
+    HKEY video, config, hkey;
+    UINT index, dpi = 0, flags;
+    DWORD size;
+
+    if (!(video = reg_open_ascii_key( NULL, devicemap_video_keyA ))) return 0;
+    if (!(config = reg_open_ascii_key( NULL, config_keyA )))
+    {
+        NtClose( video );
+        return 0;
+    }
+
+    for (index = 0; !dpi; index++)
+    {
+        snprintf( buffer, sizeof(buffer), "\\Device\\Video%u", index );
+        size = query_reg_ascii_value( video, buffer, value, sizeof(buffer) );
+        if (!size || value->Type != REG_SZ || value->DataLength / sizeof(WCHAR) <= prefix_len) break;
+        if (!(hkey = reg_open_key( config, value_str + prefix_len,
+                                   value->DataLength - (prefix_len + 1) * sizeof(WCHAR) )))
+            continue;
+        flags = 0;
+        if (query_reg_ascii_value( hkey, "StateFlags", value, sizeof(buffer) ) && value->Type == REG_DWORD)
+            flags = *(const DWORD *)value->Data;
+        if ((flags & DISPLAY_DEVICE_PRIMARY_DEVICE) &&
+            query_reg_ascii_value( hkey, "Dpi", value, sizeof(buffer) ) && value->Type == REG_DWORD)
+            dpi = *(const DWORD *)value->Data;
+        NtClose( hkey );
+    }
+
+    NtClose( config );
+    NtClose( video );
+    return dpi;
+}
