+#include <stdarg.h>
+#include <string.h>
+
+#include "ntstatus.h"
+#include "windef.h"
+#include "winternl.h"
+#include "ntdll_misc.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(module);
+
+struct code_site
+{
+    DWORD rva;
+    BYTE before[16];
+    BYTE old[8];
+    BYTE new[8];
+    BYTE after[16];
+};
+
+struct code_fix
+{
+    const WCHAR *name;
+    WORD machine;
+    DWORD timestamp;
+    DWORD image_size;
+    const char *what;
+    unsigned int count;
+    const struct code_site *sites;
+};
+
+/* 10x 1.0.565 hangs at about 1 in 130 exits, on Windows too: the window
+ * closes but the process stays, and 10x won't start again until it's
+ * killed. It waits for counters to reach 0 with an inlined
+ *
+ *     while (count) { old = count; while (count == old) WaitOnAddress( &count, &old, 4, 200 ); }
+ *
+ * which reads count again for old after testing it. When the last worker
+ * exits between the reads, old is 0 and it waits for 0 to change, forever.
+ * At each site the second read becomes a nop of the same length, so old is
+ * the value just tested (still in eax). To be dropped once 10x fixes it. */
+static const struct code_site tenx_565_sites[] =
+{
+    /* thread pool shutdown: mov eax,[rbx] */
+    { 0x16a70, { 0x00,0x00,0x48,0x8b,0x6c,0x24,0x48,0x8b,0x03,0x90,0x85,0xc0,0x74,0x3b,0x66,0x90 },
+      { 0x8b,0x03,0x89,0x44,0x24,0x40,0x66,0x66 }, { 0x66,0x90,0x89,0x44,0x24,0x40,0x66,0x66 },
+      { 0x0f,0x1f,0x84,0x00,0x00,0x00,0x00,0x00,0x41,0xb9,0xc8,0x00,0x00,0x00,0x48,0x8d } },
+    /* before CoUninitialize: mov eax,[rdi+0x2f8] */
+    { 0x38760, { 0xf8,0x02,0x00,0x00,0x90,0x85,0xc0,0x74,0x4c,0x0f,0x1f,0x80,0x00,0x00,0x00,0x00 },
+      { 0x8b,0x87,0xf8,0x02,0x00,0x00,0x89,0x44 }, { 0x66,0x0f,0x1f,0x44,0x00,0x00,0x89,0x44 },
+      { 0x24,0x38,0x66,0x0f,0x1f,0x44,0x00,0x00,0x41,0xb9,0xc8,0x00,0x00,0x00,0x41,0xb8 } },
+    /* app shutdown: mov eax,[rdi+0x3df0] */
+    { 0x63bf0, { 0x00,0x8b,0x87,0xf0,0x3d,0x00,0x00,0x90,0x85,0xc0,0x74,0x47,0x0f,0x1f,0x40,0x00 },
+      { 0x8b,0x87,0xf0,0x3d,0x00,0x00,0x89,0x45 }, { 0x66,0x0f,0x1f,0x44,0x00,0x00,0x89,0x45 },
+      { 0x48,0x0f,0x1f,0x80,0x00,0x00,0x00,0x00,0x41,0xb9,0xc8,0x00,0x00,0x00,0x41,0xb8 } },
+};
+
+static const struct code_fix code_fixes[] =
+{
+    { L"10x.exe", IMAGE_FILE_MACHINE_AMD64, 0x6ac3c8f0, 0x989000, "exit hang",
+      ARRAY_SIZE(tenx_565_sites), tenx_565_sites },
+};
+
+static BOOL sites_match( BYTE *base, const struct code_fix *fix )
+{
+    unsigned int i;
+
+    for (i = 0; i < fix->count; i++)
+    {
+        const struct code_site *site = &fix->sites[i];
+        const BYTE *p = base + site->rva;
+
+        if (site->rva < sizeof(site->before) ||
+            site->rva + sizeof(site->old) + sizeof(site->after) > fix->image_size) return FALSE;
+        if (memcmp( p - sizeof(site->before), site->before, sizeof(site->before) ) ||
+            memcmp( p, site->old, sizeof(site->old) ) ||
+            memcmp( p + sizeof(site->old), site->after, sizeof(site->after) )) return FALSE;
+    }
+    return TRUE;
+}
+
+/***********************************************************************
+ *           apply_app_fixes
+ *
+ * Patches the main executable's code if it is a build with a known bug,
+ * before any of its code runs. The executable's name, machine, link time
+ * and image size must all match, and the bytes around every site too;
+ * otherwise nothing is changed.
+ */
+void apply_app_fixes( void *module, const UNICODE_STRING *name )
+{
+    const IMAGE_NT_HEADERS *nt = RtlImageNtHeader( module );
+    unsigned int i, j;
+
+    if (!nt) return;
+    for (i = 0; i < ARRAY_SIZE(code_fixes); i++)
+    {
+        const struct code_fix *fix = &code_fixes[i];
+        UNICODE_STRING fix_name;
+
+        RtlInitUnicodeString( &fix_name, fix->name );
+        if (RtlEqualUnicodeString( name, &fix_name, TRUE ) &&
+            nt->FileHeader.Machine == fix->machine &&
+            nt->FileHeader.TimeDateStamp == fix->timestamp &&
+            nt->OptionalHeader.SizeOfImage == fix->image_size &&
+            sites_match( module, fix ))
+        {
+            for (j = 0; j < fix->count; j++)
+            {
+                void *addr = (BYTE *)module + fix->sites[j].rva;
+                SIZE_T size = sizeof(fix->sites[j].new);
+                ULONG prot;
+
+                if (NtProtectVirtualMemory( NtCurrentProcess(), &addr, &size, PAGE_EXECUTE_READWRITE, &prot ))
+                    continue;
+                memcpy( (BYTE *)module + fix->sites[j].rva, fix->sites[j].new, sizeof(fix->sites[j].new) );
+                NtProtectVirtualMemory( NtCurrentProcess(), &addr, &size, prot, &prot );
+            }
+            NtFlushInstructionCache( NtCurrentProcess(), module, fix->image_size );
+            TRACE( "fixed %s in %s\n", fix->what, debugstr_us( name ) );
+        }
+    }
+}
