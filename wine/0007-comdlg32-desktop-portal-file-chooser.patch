 /**************************************************************************
+ * The desktop portal's file chooser
+ *
+ * When the dialog isn't customized, it is shown by the desktop
+ * (org.freedesktop.portal.FileChooser) instead, as a child of the owner's
+ * window. Wine's own dialog is used whenever the portal isn't available.
+ */
+static BOOL portal_available;
+
+static BOOL WINAPI init_portal(INIT_ONCE *once, void *param, void **context)
+{
+    portal_available = !__wine_init_unix_call();
+    return TRUE;
+}
+
+static char *strdupWtoU8(const WCHAR *str)
+{
+    int len = WideCharToMultiByte(CP_UTF8, 0, str, -1, NULL, 0, NULL, NULL);
+    char *ret = malloc(len);
+
+    if (ret) WideCharToMultiByte(CP_UTF8, 0, str, -1, ret, len, NULL, NULL);
+    return ret;
+}
+
+/* "&Open" to "_Open"; "&&" is a literal "&", and a literal "_" is "__" */
+static char *portal_label(const WCHAR *label)
+{
+    WCHAR *buf = malloc((lstrlenW(label) * 2 + 1) * sizeof(WCHAR)), *p = buf;
+    char *ret;
+
+    if (!buf) return NULL;
+    for (; *label; label++)
+    {
+        if (*label == '&' && label[1] == '&') *p++ = *label++;
+        else if (*label == '&') *p++ = '_';
+        else if (*label == '_') { *p++ = '_'; *p++ = '_'; }
+        else *p++ = *label;
+    }
+    *p = 0;
+    ret = strdupWtoU8(buf);
+    free(buf);
+    return ret;
+}
+
+static char *portal_unix_path(const WCHAR *path)
+{
+    char *unix_path, *ret = NULL;
+
+    if ((unix_path = wine_get_unix_file_name(path)))
+    {
+        ret = strdup(unix_path);
+        HeapFree(GetProcessHeap(), 0, unix_path);
+    }
+    return ret;
+}
+
+static WCHAR *item_path(IShellItem *item)
+{
+    WCHAR *path;
+
+    if (!item || FAILED(IShellItem_GetDisplayName(item, SIGDN_FILESYSPATH, &path)))
+        return NULL;
+    return path;
+}
+
+/* SetFileName() may be given a path; like Windows, it then overrides the folder */
+static void portal_folder_and_name(FileDialogImpl *This, char **folder, char **name)
+{
+    WCHAR *dir = item_path(This->psi_setfolder ? This->psi_setfolder :
+                           This->app_defaultfolder ? This->psi_defaultfolder : NULL);
+    const WCHAR *file_name = This->dlg_type == ITEMDLG_TYPE_SAVE ? This->set_filename : NULL;
+    const WCHAR *base = file_name, *p;
+    WCHAR buf[MAX_PATH], *sub;
+
+    *name = NULL;
+    for (p = file_name; p && *p; p++) if (*p == '\\' || *p == '/') base = p + 1;
+    if (base != file_name && (sub = malloc((base - file_name + 1) * sizeof(WCHAR))))
+    {
+        memcpy(sub, file_name, (base - file_name) * sizeof(WCHAR));
+        sub[base - file_name] = 0;
+        if ((dir && PathIsRelativeW(sub) && PathCombineW(buf, dir, sub)) ||
+            GetFullPathNameW(sub, ARRAY_SIZE(buf), buf, NULL))
+        {
+            CoTaskMemFree(dir);
+            dir = NULL;
+            *folder = portal_unix_path(buf);
+        }
+        free(sub);
+    }
+    if (dir) *folder = portal_unix_path(dir);
+    CoTaskMemFree(dir);
+    if (base && *base) *name = strdupWtoU8(base);
+}
+
+/* the toplevel's xdg-foreign handle, published by the Wayland driver */
+static char *portal_parent(HWND owner)
+{
+    HWND root = owner ? GetAncestor(owner, GA_ROOT) : NULL;
+    ATOM atom = root ? HandleToUlong(GetPropW(root, L"__wine_xdg_foreign_handle")) : 0;
+    char handle[256], *ret;
+
+    if (!atom || !GlobalGetAtomNameA(atom, handle, sizeof(handle)))
+        return strdup("");
+    if ((ret = malloc(strlen(handle) + sizeof("wayland:"))))
+        sprintf(ret, "wayland:%s", handle);
+    return ret;
+}
+
+/* filter_count pairs of UTF-8 strings: name, patterns */
+static char *portal_filters(FileDialogImpl *This, UINT *count)
+{
+    char *ret = NULL, *p;
+    size_t size = 0;
+    UINT i;
+    int len;
+
+    *count = 0;
+    for (i = 0; i < This->filterspec_count; i++)
+    {
+        if (!This->filterspecs[i].pszName || !This->filterspecs[i].pszSpec) return NULL;
+        size += WideCharToMultiByte(CP_UTF8, 0, This->filterspecs[i].pszName, -1, NULL, 0, NULL, NULL);
+        size += WideCharToMultiByte(CP_UTF8, 0, This->filterspecs[i].pszSpec, -1, NULL, 0, NULL, NULL);
+    }
+    if (!size || !(ret = p = malloc(size))) return NULL;
+    for (i = 0; i < This->filterspec_count; i++)
+    {
+        len = WideCharToMultiByte(CP_UTF8, 0, This->filterspecs[i].pszName, -1, p, ret + size - p, NULL, NULL);
+        p += len;
+        len = WideCharToMultiByte(CP_UTF8, 0, This->filterspecs[i].pszSpec, -1, p, ret + size - p, NULL, NULL);
+        p += len;
+    }
+    *count = This->filterspec_count;
+    return ret;
+}
+
+static DWORD WINAPI portal_wait_thread(void *arg)
+{
+    return WINE_UNIX_CALL(unix_portal_wait, arg);
+}
+
+/* runs the owner's messages until the dialog is closed, like a modal dialog */
+static void portal_modal_loop(struct portal_request_params *req, HANDLE thread)
+{
+    BOOL quit = FALSE;
+    WPARAM quit_code = 0;
+    MSG msg;
+
+    while (MsgWaitForMultipleObjects(1, &thread, FALSE, INFINITE, QS_ALLINPUT) != WAIT_OBJECT_0)
+    {
+        while (PeekMessageW(&msg, 0, 0, 0, PM_REMOVE))
+        {
+            if (msg.message == WM_QUIT)
+            {
+                quit = TRUE;
+                quit_code = msg.wParam;
+                WINE_UNIX_CALL(unix_portal_cancel, req);
+                break;
+            }
+            TranslateMessage(&msg);
+            DispatchMessageW(&msg);
+        }
+        if (quit)
+        {
+            WaitForSingleObject(thread, INFINITE);
+            break;
+        }
+    }
+    if (quit) PostQuitMessage(quit_code);
+}
+
+static HRESULT portal_results(FileDialogImpl *This, struct portal_request_params *req)
+{
+    struct portal_result_params params = { .request = req->request };
+    LPITEMIDLIST *pidla = NULL;
+    IShellFolder *psf_desktop;
+    UINT count = 0, i;
+    char *path;
+    HRESULT hr;
+
+    WINE_UNIX_CALL(unix_portal_result, &params);
+    if (params.response)
+        return HRESULT_FROM_WIN32(ERROR_CANCELLED);
+    if (!(params.buffer = malloc(params.needed)))
+        return E_OUTOFMEMORY;
+    params.size = params.needed;
+    WINE_UNIX_CALL(unix_portal_result, &params);
+
+    for (path = params.buffer; *path; path += strlen(path) + 1) count++;
+    if (!count || !(pidla = calloc(count, sizeof(*pidla))))
+    {
+        free(params.buffer);
+        return count ? E_OUTOFMEMORY : HRESULT_FROM_WIN32(ERROR_CANCELLED);
+    }
+    for (i = 0, path = params.buffer; *path; path += strlen(path) + 1)
+    {
+        WCHAR *dos_path = wine_get_dos_file_name(path);
+
+        TRACE("chose %s -> %s\n", debugstr_a(path), debugstr_w(dos_path));
+        if (!dos_path) continue;
+        if ((pidla[i] = SHSimpleIDListFromPath(dos_path))) i++;
+        HeapFree(GetProcessHeap(), 0, dos_path);
+    }
+    free(params.buffer);
+
+    hr = i ? SHGetDesktopFolder(&psf_desktop) : E_FAIL;
+    if (SUCCEEDED(hr))
+    {
+        if (This->psia_results)
+        {
+            IShellItemArray_Release(This->psia_results);
+            This->psia_results = NULL;
+        }
+        hr = SHCreateShellItemArray(NULL, psf_desktop, i, (PCUITEMID_CHILD_ARRAY)pidla, &This->psia_results);
+        IShellFolder_Release(psf_desktop);
+    }
+    while (i) ILFree(pidla[--i]);
+    free(pidla);
+
+    if (SUCCEEDED(hr) && params.filter < This->filterspec_count)
+    {
+        This->filetypeindex = params.filter;
+        set_current_filter(This, This->filterspecs[This->filetypeindex].pszSpec);
+    }
+    return hr;
+}
+
+/* returns FALSE to fall back to Wine's own dialog */
+static BOOL show_portal(FileDialogImpl *This, HWND owner, HRESULT *ret)
+{
+    static INIT_ONCE once = INIT_ONCE_STATIC_INIT;
+    struct portal_open_params params = { 0 };
+    struct portal_request_params req;
+    char *title, *label = NULL, *folder = NULL, *name = NULL, *filters = NULL, *parent;
+    HWND root = owner ? GetAncestor(owner, GA_ROOT) : NULL;
+    BOOL enabled = FALSE, shown = FALSE;
+    HANDLE thread;
+    WCHAR buf[64];
+
+    /* events and custom controls need Wine's dialog */
+    if (!list_empty(&This->events_clients) || !list_empty(&This->cctrls)) return FALSE;
+    /* the portal can't add the extension */
+    if (This->dlg_type == ITEMDLG_TYPE_SAVE && This->default_ext) return FALSE;
+
+    InitOnceExecuteOnce(&once, init_portal, NULL, NULL);
+    if (!portal_available) return FALSE;
+
+    if (This->custom_title)
+        title = strdupWtoU8(This->custom_title);
+    else
+    {
+        LoadStringW(COMDLG32_hInstance, IDS_OPEN, buf, ARRAY_SIZE(buf));
+        title = strdupWtoU8(buf);
+    }
+    if (This->custom_okbutton) label = portal_label(This->custom_okbutton);
+    /* without the application's own folder, the desktop's default is used
+     * rather than the stand-in Desktop folder */
+    portal_folder_and_name(This, &folder, &name);
+    parent = portal_parent(owner);
+
+    if (This->dlg_type == ITEMDLG_TYPE_SAVE)
+        params.flags |= PORTAL_SAVE;
+    else
+    {
+        if (This->options & FOS_ALLOWMULTISELECT) params.flags |= PORTAL_MULTIPLE;
+        if (This->options & FOS_PICKFOLDERS) params.flags |= PORTAL_DIRECTORY;
+    }
+    if (!(This->options & FOS_PICKFOLDERS))
+        filters = portal_filters(This, &params.filter_count);
+
+    params.parent = parent;
+    params.title = title;
+    params.accept_label = label;
+    params.folder = folder;
+    params.name = name;
+    params.filters = filters;
+    params.current_filter = params.filter_count ? This->filetypeindex : ~0u;
+
+    if (title && parent && !WINE_UNIX_CALL(unix_portal_open, &params))
+    {
+        req.request = params.request;
+        if (root) enabled = !EnableWindow(root, FALSE);
+        if ((thread = CreateThread(NULL, 0, portal_wait_thread, &req, 0, NULL)))
+        {
+            This->portal_shown = TRUE;
+            portal_modal_loop(&req, thread);
+            This->portal_shown = FALSE;
+            CloseHandle(thread);
+            *ret = portal_results(This, &req);
+            shown = TRUE;
+        }
+        else WINE_UNIX_CALL(unix_portal_cancel, &req);
+        if (enabled)
+        {
+            EnableWindow(root, TRUE);
+            /* the desktop may hand the owner back its activation while it is
+             * still disabled, which leaves it without the focus that comes
+             * with activation */
+            if (GetActiveWindow() == root && !GetFocus()) SetFocus(root);
+        }
+        WINE_UNIX_CALL(unix_portal_close, &req);
+    }
+    else WARN("portal not available, using Wine's dialog\n");
+
+    free(title);
+    free(label);
+    free(folder);
+    free(name);
+    free(filters);
+    free(parent);
+    TRACE("portal %s, hr %#lx\n", shown ? "shown" : "not shown", shown ? *ret : 0);
+    return shown;
+}
