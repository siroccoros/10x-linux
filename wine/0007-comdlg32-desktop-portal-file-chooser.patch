+static BOOL dbus_loaded;
+
+static void load_dbus_once(void)
+{
+    void *handle;
+
+    if (!(handle = dlopen( SONAME_LIBDBUS_1, RTLD_NOW ))) goto failed;
+#define DO_FUNC(f) if (!(p_##f = dlsym( handle, #f ))) goto failed
+    DBUS_FUNCS;
+#undef DO_FUNC
+    p_dbus_threads_init_default();
+    dbus_loaded = TRUE;
+    return;
+failed:
+    WARN( "failed to load DBus support: %s\n", dlerror() );
+}
+
+static BOOL load_dbus(void)
+{
+    static pthread_once_t once = PTHREAD_ONCE_INIT;
+
+    pthread_once( &once, load_dbus_once );
+    return dbus_loaded;
+}
+
+struct request
+{
+    DBusConnection *connection;
+    char *path;                 /* the portal's Request object */
+    volatile LONG cancelled;
+    BOOL done;
+    UINT32 response;
+    char *paths;                /* chosen Unix paths, each null-terminated */
+    size_t paths_size;
+    char *filter;               /* name of the chosen filter */
+    char **filter_names;
+    UINT32 filter_count;
+};
+
+static void free_request( struct request *req )
+{
+    UINT32 i;
+
+    if (req->connection)
+    {
+        p_dbus_connection_close( req->connection );
+        p_dbus_connection_unref( req->connection );
+    }
+    for (i = 0; i < req->filter_count; i++) free( req->filter_names[i] );
+    free( req->filter_names );
+    free( req->path );
+    free( req->paths );
+    free( req->filter );
+    free( req );
+}
+
+/* a{sv} entry helpers */
+
+static void open_entry( DBusMessageIter *dict, DBusMessageIter *entry, DBusMessageIter *variant,
+                        const char *key, const char *signature )
+{
+    p_dbus_message_iter_open_container( dict, DBUS_TYPE_DICT_ENTRY, NULL, entry );
+    p_dbus_message_iter_append_basic( entry, DBUS_TYPE_STRING, &key );
+    p_dbus_message_iter_open_container( entry, DBUS_TYPE_VARIANT, signature, variant );
+}
+
+static void close_entry( DBusMessageIter *dict, DBusMessageIter *entry, DBusMessageIter *variant )
+{
+    p_dbus_message_iter_close_container( entry, variant );
+    p_dbus_message_iter_close_container( dict, entry );
+}
+
+static void append_string_entry( DBusMessageIter *dict, const char *key, const char *value )
+{
+    DBusMessageIter entry, variant;
+
+    open_entry( dict, &entry, &variant, key, "s" );
+    p_dbus_message_iter_append_basic( &variant, DBUS_TYPE_STRING, &value );
+    close_entry( dict, &entry, &variant );
+}
+
+static void append_bool_entry( DBusMessageIter *dict, const char *key, BOOL value )
+{
+    DBusMessageIter entry, variant;
+    dbus_bool_t b = !!value;
+
+    open_entry( dict, &entry, &variant, key, "b" );
+    p_dbus_message_iter_append_basic( &variant, DBUS_TYPE_BOOLEAN, &b );
+    close_entry( dict, &entry, &variant );
+}
+
+static void append_bytes_entry( DBusMessageIter *dict, const char *key, const char *value )
+{
+    DBusMessageIter entry, variant, array;
+    const unsigned char *p = (const unsigned char *)value;
+
+    open_entry( dict, &entry, &variant, key, "ay" );
+    p_dbus_message_iter_open_container( &variant, DBUS_TYPE_ARRAY, "y", &array );
+    do p_dbus_message_iter_append_basic( &array, DBUS_TYPE_BYTE, p ); while (*p++);
+    p_dbus_message_iter_close_container( &variant, &array );
+    close_entry( dict, &entry, &variant );
+}
+
+/* Windows wildcards match case-insensitively, the portal's globs don't: "*.cpp"
+ * becomes "*.[cC][pP][pP]"; "[" is literal in Windows, so it is escaped. */
+static char *make_glob( const char *pattern, size_t len )
+{
+    char *ret, *p;
+    size_t i;
+
+    if (len == 3 && !memcmp( pattern, "*.*", 3 )) return strdup( "*" );
+    if (!(ret = p = malloc( len * 4 + 1 ))) return NULL;
+    for (i = 0; i < len; i++)
+    {
+        unsigned char c = pattern[i];
+        if (c < 0x80 && isalpha( c ) && tolower( c ) != toupper( c ))
+        {
+            *p++ = '[';
+            *p++ = tolower( c );
+            *p++ = toupper( c );
+            *p++ = ']';
+        }
+        else if (c == '[')
+        {
+            memcpy( p, "[[]", 3 );
+            p += 3;
+        }
+        else *p++ = c;
+    }
+    *p = 0;
+    return ret;
+}
+
+/* (sa(us)): name and glob patterns */
+static void append_filter( DBusMessageIter *iter, const char *name, const char *patterns )
+{
+    DBusMessageIter filter, list, item;
+    const char *p = patterns, *end;
+    dbus_uint32_t glob = 0;
+
+    p_dbus_message_iter_open_container( iter, DBUS_TYPE_STRUCT, NULL, &filter );
+    p_dbus_message_iter_append_basic( &filter, DBUS_TYPE_STRING, &name );
+    p_dbus_message_iter_open_container( &filter, DBUS_TYPE_ARRAY, "(us)", &list );
+    for (;;)
+    {
+        char *pattern;
+
+        while (*p == ' ' || *p == ';') p++;
+        if (!*p) break;
+        for (end = p; *end && *end != ';'; end++);
+        while (end > p && end[-1] == ' ') end--;
+        if ((pattern = make_glob( p, end - p )))
+        {
+            p_dbus_message_iter_open_container( &list, DBUS_TYPE_STRUCT, NULL, &item );
+            p_dbus_message_iter_append_basic( &item, DBUS_TYPE_UINT32, &glob );
+            p_dbus_message_iter_append_basic( &item, DBUS_TYPE_STRING, &pattern );
+            p_dbus_message_iter_close_container( &list, &item );
+            free( pattern );
+        }
+        p = end;
+    }
+    p_dbus_message_iter_close_container( &filter, &list );
+    p_dbus_message_iter_close_container( iter, &filter );
+}
+
+static void append_filters( DBusMessageIter *dict, const struct portal_open_params *params )
+{
+    DBusMessageIter entry, variant, array;
+    const char *name = params->filters, *patterns;
+    UINT32 i;
+
+    open_entry( dict, &entry, &variant, "filters", "a(sa(us))" );
+    p_dbus_message_iter_open_container( &variant, DBUS_TYPE_ARRAY, "(sa(us))", &array );
+    for (i = 0; i < params->filter_count; i++)
+    {
+        patterns = name + strlen( name ) + 1;
+        append_filter( &array, name, patterns );
+        name = patterns + strlen( patterns ) + 1;
+    }
+    p_dbus_message_iter_close_container( &variant, &array );
+    close_entry( dict, &entry, &variant );
+
+    if (params->current_filter >= params->filter_count) return;
+    name = params->filters;
+    for (i = 0; i < params->current_filter; i++)
+    {
+        name += strlen( name ) + 1;
+        name += strlen( name ) + 1;
+    }
+    open_entry( dict, &entry, &variant, "current_filter", "(sa(us))" );
+    append_filter( &variant, name, name + strlen( name ) + 1 );
+    close_entry( dict, &entry, &variant );
+}
+
+static NTSTATUS portal_open( void *args )
+{
+    struct portal_open_params *params = args;
+    const char *method = (params->flags & PORTAL_SAVE) ? "SaveFile" : "OpenFile";
+    char token[32], match[512], *sender, *p;
+    DBusMessage *call, *reply;
+    DBusMessageIter iter, dict;
+    struct request *req;
+    const char *path, *name;
+    DBusError error;
+    UINT32 i;
+
+    if (!load_dbus()) return STATUS_NOT_SUPPORTED;
+    if (!(req = calloc( 1, sizeof(*req) ))) return STATUS_NO_MEMORY;
+
+    p_dbus_error_init( &error );
+    if (!(req->connection = p_dbus_bus_get_private( DBUS_BUS_SESSION, &error )))
+    {
+        WARN( "no session bus: %s\n", error.message );
+        p_dbus_error_free( &error );
+        free_request( req );
+        return STATUS_NOT_SUPPORTED;
+    }
+    p_dbus_connection_set_exit_on_disconnect( req->connection, FALSE );
+
+    /* the Request object path is known in advance; listen before asking, so the
+     * Response can't be missed */
+    snprintf( token, sizeof(token), "wine%u_%p", (unsigned)getpid(), req );
+    for (p = token; *p; p++) if (!isalnum( (unsigned char)*p )) *p = '_';
+    if (!(sender = strdup( p_dbus_bus_get_unique_name( req->connection ) + 1 ))) goto failed;
+    for (p = sender; *p; p++) if (*p == '.') *p = '_';
+    if (!(req->path = malloc( strlen( sender ) + strlen( token ) + 64 )))
+    {
+        free( sender );
+        goto failed;
+    }
+    sprintf( req->path, "/org/freedesktop/portal/desktop/request/%s/%s", sender, token );
+    free( sender );
+    snprintf( match, sizeof(match), "type='signal',interface='org.freedesktop.portal.Request',"
+              "member='Response',path='%s'", req->path );
+    p_dbus_bus_add_match( req->connection, match, &error );
+    if (p_dbus_error_is_set( &error )) goto failed;
+
+    if (!(call = p_dbus_message_new_method_call( "org.freedesktop.portal.Desktop", "/org/freedesktop/portal/desktop",
+                                                 "org.freedesktop.portal.FileChooser", method )))
+        goto failed;
+    p_dbus_message_iter_init_append( call, &iter );
+    p_dbus_message_iter_append_basic( &iter, DBUS_TYPE_STRING, &params->parent );
+    p_dbus_message_iter_append_basic( &iter, DBUS_TYPE_STRING, &params->title );
+    p_dbus_message_iter_open_container( &iter, DBUS_TYPE_ARRAY, "{sv}", &dict );
+    append_string_entry( &dict, "handle_token", token );
+    append_bool_entry( &dict, "modal", TRUE );
+    if (params->accept_label) append_string_entry( &dict, "accept_label", params->accept_label );
+    if (!(params->flags & PORTAL_SAVE))
+    {
+        append_bool_entry( &dict, "multiple", params->flags & PORTAL_MULTIPLE );
+        append_bool_entry( &dict, "directory", params->flags & PORTAL_DIRECTORY );
+    }
+    else if (params->name) append_string_entry( &dict, "current_name", params->name );
+    if (params->folder) append_bytes_entry( &dict, "current_folder", params->folder );
+    if (params->filter_count) append_filters( &dict, params );
+    p_dbus_message_iter_close_container( &iter, &dict );
+
+    reply = p_dbus_connection_send_with_reply_and_block( req->connection, call, -1, &error );
+    p_dbus_message_unref( call );
+    if (!reply)
+    {
+        WARN( "%s failed: %s\n", method, error.message );
+        goto failed;
+    }
+    /* older portals pick their own path */
+    if (p_dbus_message_iter_init( reply, &iter ) && p_dbus_message_iter_get_arg_type( &iter ) == DBUS_TYPE_OBJECT_PATH)
+    {
+        p_dbus_message_iter_get_basic( &iter, &path );
+        if (strcmp( path, req->path ))
+        {
+            free( req->path );
+            req->path = strdup( path );
+            snprintf( match, sizeof(match), "type='signal',interface='org.freedesktop.portal.Request',"
+                      "member='Response',path='%s'", path );
+            p_dbus_bus_add_match( req->connection, match, NULL );
+        }
+    }
+    p_dbus_message_unref( reply );
+    if (!req->path) goto failed;
+
+    /* kept to map the chosen filter back to its index */
+    if (params->filter_count && (req->filter_names = calloc( params->filter_count, sizeof(char *) )))
+    {
+        name = params->filters;
+        for (i = 0; i < params->filter_count; i++)
+        {
+            req->filter_names[i] = strdup( name );
+            name += strlen( name ) + 1;
+            name += strlen( name ) + 1;
+        }
+        req->filter_count = params->filter_count;
+    }
+
+    TRACE( "%s request %s\n", method, req->path );
+    params->request = (UINT_PTR)req;
+    return STATUS_SUCCESS;
+
+failed:
+    p_dbus_error_free( &error );
+    free_request( req );
+    return STATUS_NOT_SUPPORTED;
+}
+
+static int hex_value( char c )
+{
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+
+/* file:// URIs only; returns the decoded length, or 0 */
+static size_t uri_to_path( const char *uri, char *out )
+{
+    const char *p;
+    size_t len = 0;
+
+    if (strncmp( uri, "file://", 7 )) return 0;
+    p = uri + 7;
+    if (*p != '/')  /* file://host/path, local host only */
+    {
+        if (strncmp( p, "localhost/", 10 )) return 0;
+        p += 9;
+    }
+    while (*p)
+    {
+        if (*p == '%' && hex_value( p[1] ) >= 0 && hex_value( p[2] ) >= 0)
+        {
+            out[len++] = hex_value( p[1] ) * 16 + hex_value( p[2] );
+            p += 3;
+        }
+        else out[len++] = *p++;
+    }
+    out[len++] = 0;
+    return len;
+}
+
+static void parse_response( struct request *req, DBusMessage *msg )
+{
+    DBusMessageIter iter, dict, entry, variant, array, filter;
+    dbus_uint32_t response;
+    const char *key, *str;
+
+    req->done = TRUE;
+    req->response = 2;
+    if (!p_dbus_message_iter_init( msg, &iter ) || p_dbus_message_iter_get_arg_type( &iter ) != DBUS_TYPE_UINT32)
+        return;
+    p_dbus_message_iter_get_basic( &iter, &response );
+    req->response = response;
+    if (response || !p_dbus_message_iter_next( &iter ) || p_dbus_message_iter_get_arg_type( &iter ) != DBUS_TYPE_ARRAY)
+        return;
+
+    p_dbus_message_iter_recurse( &iter, &dict );
+    while (p_dbus_message_iter_get_arg_type( &dict ) == DBUS_TYPE_DICT_ENTRY)
+    {
+        p_dbus_message_iter_recurse( &dict, &entry );
+        p_dbus_message_iter_get_basic( &entry, &key );
+        p_dbus_message_iter_next( &entry );
+        p_dbus_message_iter_recurse( &entry, &variant );
+
+        if (!strcmp( key, "uris" ) && p_dbus_message_iter_get_arg_type( &variant ) == DBUS_TYPE_ARRAY)
+        {
+            p_dbus_message_iter_recurse( &variant, &array );
+            while (p_dbus_message_iter_get_arg_type( &array ) == DBUS_TYPE_STRING)
+            {
+                char *paths;
+                size_t len;
+
+                p_dbus_message_iter_get_basic( &array, &str );
+                if ((paths = realloc( req->paths, req->paths_size + strlen( str ) + 1 )))
+                {
+                    req->paths = paths;
+                    if ((len = uri_to_path( str, paths + req->paths_size ))) req->paths_size += len;
+                    else WARN( "ignoring %s\n", debugstr_a(str) );
+                }
+                p_dbus_message_iter_next( &array );
+            }
+        }
+        else if (!strcmp( key, "current_filter" ) && p_dbus_message_iter_get_arg_type( &variant ) == DBUS_TYPE_STRUCT)
+        {
+            p_dbus_message_iter_recurse( &variant, &filter );
+            if (p_dbus_message_iter_get_arg_type( &filter ) == DBUS_TYPE_STRING)
+            {
+                p_dbus_message_iter_get_basic( &filter, &str );
+                free( req->filter );
+                req->filter = strdup( str );
+            }
+        }
+        p_dbus_message_iter_next( &dict );
+    }
+}
+
+/* blocks until the dialog is closed or the request cancelled */
+static NTSTATUS portal_wait( void *args )
+{
+    struct request *req = (struct request *)(UINT_PTR)((struct portal_request_params *)args)->request;
+    DBusMessage *msg;
+
+    while (!req->done)
+    {
+        if (req->cancelled)
+        {
+            req->done = TRUE;
+            req->response = 1;
+            break;
+        }
+        /* wakes up now and then to notice a cancel */
+        if (!p_dbus_connection_read_write( req->connection, 250 ))
+        {
+            req->done = TRUE;
+            req->response = 2;
+            break;
+        }
+        while (!req->done && (msg = p_dbus_connection_pop_message( req->connection )))
+        {
+            if (p_dbus_message_is_signal( msg, "org.freedesktop.portal.Request", "Response" ) &&
+                p_dbus_message_get_path( msg ) && !strcmp( p_dbus_message_get_path( msg ), req->path ))
+                parse_response( req, msg );
+            p_dbus_message_unref( msg );
+        }
+    }
+    TRACE( "%s response %u\n", req->path, req->response );
+    return STATUS_SUCCESS;
+}
+
+/* closes the dialog; may be called while another thread waits */
+static NTSTATUS portal_cancel( void *args )
+{
+    struct request *req = (struct request *)(UINT_PTR)((struct portal_request_params *)args)->request;
+    DBusMessage *call;
+
+    if ((call = p_dbus_message_new_method_call( "org.freedesktop.portal.Desktop", req->path,
+                                                "org.freedesktop.portal.Request", "Close" )))
+    {
+        p_dbus_connection_send( req->connection, call, NULL );
+        p_dbus_connection_flush( req->connection );
+        p_dbus_message_unref( call );
+    }
+    __atomic_store_n( &req->cancelled, 1, __ATOMIC_SEQ_CST );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS portal_result( void *args )
+{
+    struct portal_result_params *params = args;
+    struct request *req = (struct request *)(UINT_PTR)params->request;
+    UINT32 i;
+
+    params->response = req->response;
+    params->filter = ~0u;
+    for (i = 0; req->filter && i < req->filter_count; i++)
+        if (req->filter_names[i] && !strcmp( req->filter_names[i], req->filter )) params->filter = i;
+    params->needed = req->paths_size + 1;
+    if (params->size < params->needed) return STATUS_BUFFER_TOO_SMALL;
+    if (req->paths_size) memcpy( params->buffer, req->paths, req->paths_size );
+    params->buffer[req->paths_size] = 0;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS portal_close( void *args )
+{
+    free_request( (struct request *)(UINT_PTR)((struct portal_request_params *)args)->request );
+    return STATUS_SUCCESS;
+}
+
+#else  /* SONAME_LIBDBUS_1 */
+
+static NTSTATUS portal_open( void *args ) { return STATUS_NOT_SUPPORTED; }
+static NTSTATUS portal_wait( void *args ) { return STATUS_NOT_SUPPORTED; }
+static NTSTATUS portal_cancel( void *args ) { return STATUS_NOT_SUPPORTED; }
+static NTSTATUS portal_result( void *args ) { return STATUS_NOT_SUPPORTED; }
+static NTSTATUS portal_close( void *args ) { return STATUS_NOT_SUPPORTED; }
+
+#endif  /* SONAME_LIBDBUS_1 */
