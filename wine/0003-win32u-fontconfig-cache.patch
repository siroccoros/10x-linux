+/* Fontconfig's part of the font list, kept in a file in the prefix next to the
+ * face cache. Reading fontconfig's configuration costs every process that uses
+ * fonts ~8 ms, yet it rarely changes. The file records the configuration files
+ * fontconfig read and the directories holding them, the font directories,
+ * fontconfig's cache directories and the places a user configuration could
+ * appear (present or not); it is used only while all of these, fontconfig's
+ * version and the environment it reads are unchanged. Fontconfig itself is
+ * then initialized only when it's asked for fallbacks. */
+
+#define FONTCONFIG_CACHE_MAGIC   0x43434657 /* "WFCC" */
+#define FONTCONFIG_CACHE_VERSION 1
+
+struct fc_stamp
+{
+    char *path;
+    BOOL exists;
+    struct face_cache_key key;
+};
+
+static struct fc_font *fc_fonts;
+static UINT fc_fonts_count, fc_fonts_size;
+static struct fc_stamp *fc_stamps;
+static UINT fc_stamps_count, fc_stamps_size;
+static BOOL fc_cache_hit;       /* the font list comes from the cache */
+static BOOL fc_cache_record;    /* collecting a new cache while walking fontconfig */
+static char *fc_cache_path;
+
+static const char * const fc_cache_env[] =
+{
+    "FONTCONFIG_FILE", "FONTCONFIG_PATH", "FONTCONFIG_SYSROOT", "HOME", "XDG_CONFIG_HOME",
+    "XDG_CACHE_HOME", "XDG_DATA_HOME", "XDG_DATA_DIRS", "FC_LANG", "LANGUAGE", "LANG",
+    "LC_ALL", "LC_CTYPE",
+};
+
+static void fc_cache_free(void)
+{
+    UINT i;
+
+    for (i = 0; i < fc_fonts_count; i++) free( fc_fonts[i].unix_name );
+    for (i = 0; i < fc_stamps_count; i++) free( fc_stamps[i].path );
+    free( fc_fonts );
+    free( fc_stamps );
+    fc_fonts = NULL;
+    fc_stamps = NULL;
+    fc_fonts_count = fc_fonts_size = fc_stamps_count = fc_stamps_size = 0;
+}
+
+static void fc_cache_stat( struct fc_stamp *stamp )
+{
+    struct stat st;
+
+    memset( &stamp->key, 0, sizeof(stamp->key) );
+    if ((stamp->exists = !stat( stamp->path, &st ))) face_cache_set_key( &stamp->key, &st );
+}
+
+static void fc_cache_add_stamp( const char *path, size_t len )
+{
+    struct fc_stamp *stamp;
+    UINT i;
+
+    if (!fc_cache_record) return;
+    for (i = 0; i < fc_stamps_count; i++)
+        if (!strncmp( fc_stamps[i].path, path, len ) && !fc_stamps[i].path[len]) return;
+    if (fc_stamps_count == fc_stamps_size)
+    {
+        UINT size = max( 64, fc_stamps_size * 2 );
+        if (!(stamp = realloc( fc_stamps, size * sizeof(*stamp) ))) goto failed;
+        fc_stamps = stamp;
+        fc_stamps_size = size;
+    }
+    stamp = &fc_stamps[fc_stamps_count];
+    if (!(stamp->path = strndup( path, len ))) goto failed;
+    fc_cache_stat( stamp );
+    fc_stamps_count++;
+    return;
+
+failed:
+    fc_cache_record = FALSE;
+}
+
+static void fc_cache_add_path( const char *path )
+{
+    fc_cache_add_stamp( path, strlen( path ) );
+}
+
+/* A file, and the directory holding it, which changes when files are added. */
+static void fc_cache_add_file( const char *path )
+{
+    const char *p = strrchr( path, '/' );
+
+    fc_cache_add_path( path );
+    if (p) fc_cache_add_stamp( path, p > path ? p - path : 1 );
+}
+
+static void fc_cache_add_font( const struct fc_font *info )
+{
+    struct fc_font *font;
+
+    if (!fc_cache_record) return;
+    if (fc_fonts_count == fc_fonts_size)
+    {
+        UINT size = max( 1024, fc_fonts_size * 2 );
+        if (!(font = realloc( fc_fonts, size * sizeof(*font) ))) goto failed;
+        fc_fonts = font;
+        fc_fonts_size = size;
+    }
+    font = &fc_fonts[fc_fonts_count];
+    *font = *info;
+    if (!(font->unix_name = strdup( info->unix_name ))) goto failed;
+    fc_fonts_count++;
+    return;
+
+failed:
+    fc_cache_record = FALSE;
+}
+
+static void fc_cache_write_string( struct face_cache_writer *w, const char *str )
+{
+    UINT len = strlen( str );
+
+    face_cache_write( w, &len, sizeof(len) );
+    face_cache_write( w, str, len );
+}
+
+static BOOL fc_cache_read_string( struct face_cache_reader *r, char **str )
+{
+    UINT len;
+
+    *str = NULL;
+    if (!face_cache_read( r, &len, sizeof(len) ) || len > 65536) return FALSE;
+    if (!(*str = malloc( len + 1 ))) return FALSE;
+    if (!face_cache_read( r, *str, len )) return FALSE;
+    (*str)[len] = 0;
+    return strlen( *str ) == len;
+}
+
+/* The environment fontconfig reads, and its version, as one string. */
+static char *fc_cache_get_env(void)
+{
+    struct face_cache_writer w = { 0 };
+    char version[16], nul = 0;
+    const char *value;
+    UINT i;
+
+    snprintf( version, sizeof(version), "%d\n", pFcGetVersion() );
+    face_cache_write( &w, version, strlen( version ) );
+    for (i = 0; i < ARRAY_SIZE(fc_cache_env); i++)
+    {
+        if (!(value = getenv( fc_cache_env[i] ))) continue;
+        face_cache_write( &w, fc_cache_env[i], strlen( fc_cache_env[i] ) );
+        face_cache_write( &w, "=", 1 );
+        face_cache_write( &w, value, strlen( value ) );
+        face_cache_write( &w, "\n", 1 );
+    }
+    face_cache_write( &w, &nul, 1 );
+    if (!w.failed) return w.data;
+    free( w.data );
+    return NULL;
+}
+
+static BOOL fc_cache_parse( const char *data, size_t size, const char *env )
+{
+    struct face_cache_reader r = { data, data + size };
+    UINT magic, version, count, i;
+    char *str;
+    BOOL ret;
+
+    if (!face_cache_read( &r, &magic, sizeof(magic) ) || magic != FONTCONFIG_CACHE_MAGIC) return FALSE;
+    if (!face_cache_read( &r, &version, sizeof(version) ) || version != FONTCONFIG_CACHE_VERSION) return FALSE;
+    ret = fc_cache_read_string( &r, &str ) && !strcmp( str, PACKAGE_VERSION );
+    free( str );
+    if (!ret) return FALSE;
+    ret = fc_cache_read_string( &r, &str ) && !strcmp( str, env );
+    free( str );
+    if (!ret) return FALSE;
+    if (!face_cache_read( &r, &default_aa_flags, sizeof(default_aa_flags) )) return FALSE;
+
+    if (!face_cache_read( &r, &count, sizeof(count) ) || count > 65536) return FALSE;
+    if (!(fc_stamps = calloc( count, sizeof(*fc_stamps) ))) return FALSE;
+    fc_stamps_size = count;
+    for (i = 0; i < count; i++)
+    {
+        struct fc_stamp *stamp = &fc_stamps[fc_stamps_count], now;
+
+        if (!fc_cache_read_string( &r, &stamp->path ))
+        {
+            free( stamp->path );
+            return FALSE;
+        }
+        fc_stamps_count++;
+        if (!face_cache_read( &r, &stamp->exists, sizeof(stamp->exists) ) ||
+            !face_cache_read( &r, &stamp->key, sizeof(stamp->key) )) return FALSE;
+        now.path = stamp->path;
+        fc_cache_stat( &now );
+        if (now.exists != stamp->exists || memcmp( &now.key, &stamp->key, sizeof(now.key) ))
+        {
+            TRACE( "%s changed\n", debugstr_a(stamp->path) );
+            return FALSE;
+        }
+    }
+
+    if (!face_cache_read( &r, &count, sizeof(count) ) || count > (1 << 20)) return FALSE;
+    if (!(fc_fonts = calloc( count, sizeof(*fc_fonts) ))) return FALSE;
+    fc_fonts_size = count;
+    for (i = 0; i < count; i++)
+    {
+        struct fc_font *font = &fc_fonts[fc_fonts_count];
+
+        if (!fc_cache_read_string( &r, &font->unix_name ))
+        {
+            free( font->unix_name );
+            return FALSE;
+        }
+        fc_fonts_count++;
+        if (!face_cache_read( &r, &font->format, sizeof(font->format) ) ||
+            !face_cache_read( &r, &font->scalable, sizeof(font->scalable) ) ||
+            !face_cache_read( &r, &font->aa_flags, sizeof(font->aa_flags) ) ||
+            !face_cache_read( &r, &font->face_index, sizeof(font->face_index) )) return FALSE;
+    }
+    return r.ptr == r.end;
+}
+
+static BOOL fc_cache_load(void)
+{
+    char *data, *env;
+    size_t size;
+    BOOL ret = FALSE;
+
+    if (!pFcGetVersion || !pFcConfigGetConfigFiles || !pFcConfigGetCacheDirs) return FALSE;
+    if (!(fc_cache_path = get_cache_file_path( "win32u-fontconfig.cache" ))) return FALSE;
+    if (!(env = fc_cache_get_env())) return FALSE;
+    if ((data = read_cache_file( fc_cache_path, &size )))
+    {
+        ret = fc_cache_parse( data, size, env );
+        free( data );
+    }
+    free( env );
+    if (!ret) fc_cache_free();
+    fc_cache_record = !ret;
+    TRACE( "%s %s\n", ret ? "using" : "not using", debugstr_a(fc_cache_path) );
+    return ret;
+}
+
+static void fc_cache_save( FcConfig *config )
+{
+    struct face_cache_writer w = { 0 };
+    UINT magic = FONTCONFIG_CACHE_MAGIC, version = FONTCONFIG_CACHE_VERSION, i;
+    const char *xdg = getenv( "XDG_CONFIG_HOME" ), *home = getenv( "HOME" );
+    const FcChar8 *path;
+    FcStrList *list;
+    char *env, buf[4096];
+
+    if (!fc_cache_record) goto done;
+
+    if ((list = pFcConfigGetConfigFiles( config )))
+    {
+        while ((path = pFcStrListNext( list ))) fc_cache_add_file( (const char *)path );
+        pFcStrListDone( list );
+    }
+    if ((list = pFcConfigGetCacheDirs( config )))
+    {
+        while ((path = pFcStrListNext( list ))) fc_cache_add_path( (const char *)path );
+        pFcStrListDone( list );
+    }
+    /* user configuration that may not exist yet */
+    if (xdg && *xdg) snprintf( buf, sizeof(buf), "%s/fontconfig", xdg );
+    else if (home && *home) snprintf( buf, sizeof(buf), "%s/.config/fontconfig", home );
+    else buf[0] = 0;
+    if (buf[0])
+    {
+        fc_cache_add_path( buf );
+        strncat( buf, "/conf.d", sizeof(buf) - strlen( buf ) - 1 );
+        fc_cache_add_path( buf );
+    }
+    if (home && *home)
+    {
+        snprintf( buf, sizeof(buf), "%s/.fonts.conf", home );
+        fc_cache_add_path( buf );
+        snprintf( buf, sizeof(buf), "%s/.fonts.conf.d", home );
+        fc_cache_add_path( buf );
+    }
+    if (!fc_cache_record || !(env = fc_cache_get_env())) goto done;
+
+    face_cache_write( &w, &magic, sizeof(magic) );
+    face_cache_write( &w, &version, sizeof(version) );
+    fc_cache_write_string( &w, PACKAGE_VERSION );
+    fc_cache_write_string( &w, env );
+    free( env );
+    face_cache_write( &w, &default_aa_flags, sizeof(default_aa_flags) );
+    face_cache_write( &w, &fc_stamps_count, sizeof(fc_stamps_count) );
+    for (i = 0; i < fc_stamps_count; i++)
+    {
+        fc_cache_write_string( &w, fc_stamps[i].path );
+        face_cache_write( &w, &fc_stamps[i].exists, sizeof(fc_stamps[i].exists) );
+        face_cache_write( &w, &fc_stamps[i].key, sizeof(fc_stamps[i].key) );
+    }
+    face_cache_write( &w, &fc_fonts_count, sizeof(fc_fonts_count) );
+    for (i = 0; i < fc_fonts_count; i++)
+    {
+        fc_cache_write_string( &w, fc_fonts[i].unix_name );
+        face_cache_write( &w, &fc_fonts[i].format, sizeof(fc_fonts[i].format) );
+        face_cache_write( &w, &fc_fonts[i].scalable, sizeof(fc_fonts[i].scalable) );
+        face_cache_write( &w, &fc_fonts[i].aa_flags, sizeof(fc_fonts[i].aa_flags) );
+        face_cache_write( &w, &fc_fonts[i].face_index, sizeof(fc_fonts[i].face_index) );
+    }
+    if (!w.failed && write_cache_file( fc_cache_path, w.data, w.size ))
+        TRACE( "saved %u fonts, %u stamps to %s\n", fc_fonts_count, fc_stamps_count,
+               debugstr_a(fc_cache_path) );
+
+done:
+    free( w.data );
+    fc_cache_record = FALSE;
+    fc_cache_free();
+}
+
+static void fontconfig_add_font( FcPattern *pattern, UINT flags )
+{
+    struct fc_font font = { 0 };
+    const char *format;
+    FcBool scalable;
+
+    TRACE( "(%p %#x)\n", pattern, flags );
+
+    if (pFcPatternGetString( pattern, FC_FILE, 0, (FcChar8 **)&font.unix_name ) != FcResultMatch)
+        return;
+    if (pFcPatternGetString( pattern, FC_FONTFORMAT, 0, (FcChar8 **)&format ) != FcResultMatch)
+        font.format = FC_FONT_FORMAT_UNKNOWN;
+    else
+        font.format = strcmp( format, "Type 1" ) ? FC_FONT_FORMAT_OTHER : FC_FONT_FORMAT_TYPE1;
+    if (pFcPatternGetBool( pattern, FC_SCALABLE, 0, &scalable ) != FcResultMatch) scalable = FALSE;
