+/* A Unix program started in a pseudo console has a pseudo terminal, which
+ * the server connects to the terminal's pipes as a Unix terminal would be:
+ * the terminal then shows its output and sends it its input, without us. */
+static NTSTATUS attach_pty( struct console *console )
+{
+    struct condrv_pty_bridge bridge = { 0 };
+    IO_STATUS_BLOCK io;
+    NTSTATUS status;
+
+    if (!console->pty && !console->is_unix && console->tty_input && console->tty_output)
+    {
+        tty_flush( console );
+        bridge.input  = condrv_handle( console->tty_input );
+        bridge.output = condrv_handle( console->tty_output );
+        bridge.width  = console->active->win.right - console->active->win.left + 1;
+        bridge.height = console->active->win.bottom - console->active->win.top + 1;
+    }
+    status = NtDeviceIoControlFile( console->server, NULL, NULL, NULL, &io, IOCTL_CONDRV_BRIDGE_PTY,
+                                    &bridge, sizeof(bridge), NULL, 0 );
+    if (!bridge.input) return STATUS_NOT_SUPPORTED;
+    if (status)
+    {
+        ERR( "pty bridge failed: %#lx\n", status );
+        return status;
+    }
+    TRACE( "the pty has the tty streams\n" );
+    console->pty = 1;
+    console->tty_output = NULL;
+    return STATUS_SUCCESS;
+}
+
+/* the terminal of a pseudo console was resized */
+static void resize_pseudo_console( struct console *console, unsigned int width, unsigned int height )
+{
+    struct screen_buffer *screen_buffer = console->active;
+    IO_STATUS_BLOCK io;
+    unsigned int scroll;
+    RECT update_rect;
+
+    TRACE( "%ux%u\n", width, height );
+    if (!width || !height) return;
+
+    if (console->pty)
+    {
+        struct condrv_pty_size size = { width, height };
+        NtDeviceIoControlFile( console->server, NULL, NULL, NULL, &io, IOCTL_CONDRV_RESIZE_PTY,
+                               &size, sizeof(size), NULL, 0 );
+        return;
+    }
+
+    /* keep the cursor's line, as the terminal does */
+    if (screen_buffer->cursor_y >= height)
+    {
+        scroll = screen_buffer->cursor_y - height + 1;
+        memmove( screen_buffer->data, screen_buffer->data + scroll * screen_buffer->width,
+                 (screen_buffer->height - scroll) * screen_buffer->width * sizeof(*screen_buffer->data) );
+        screen_buffer->cursor_y -= scroll;
+    }
+    if (change_screen_buffer_size( screen_buffer, width, height )) return;
+    SetRect( &screen_buffer->win, 0, 0, width - 1, height - 1 );
+    if (screen_buffer->cursor_x >= width) screen_buffer->cursor_x = width - 1;
+    notify_screen_buffer_size( screen_buffer );
+
+    if (!console->tty_output) return;
+    tty_write( console, "\x1b[2J\x1b[H", 7 );
+    console->tty_cursor_x = console->tty_cursor_y = 0;
+    SetRect( &update_rect, 0, 0, width - 1, height - 1 );
+    update_output( screen_buffer, &update_rect );
+    tty_sync( console );
+}
