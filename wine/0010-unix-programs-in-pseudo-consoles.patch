+ *           open_console_pty
+ *
+ * A Unix program started in a pseudo console gets a pseudo terminal, as a
+ * Unix terminal gives the programs it runs; the console's host connects the
+ * terminal to it. Returns its slave, or -1 if the console has no use for one.
+ */
+static int open_console_pty( HANDLE console )
+{
+#ifdef __linux__
+    int master, slave = -1;
+    unsigned int h;
+    HANDLE handle;
+    char name[64];
+
+    if (!console || console == CONSOLE_HANDLE_ALLOC || console == CONSOLE_HANDLE_ALLOC_NO_WINDOW ||
+        console == CONSOLE_HANDLE_SHELL || console == CONSOLE_HANDLE_SHELL_NO_WINDOW)
+        return -1;
+
+    if ((master = posix_openpt( O_RDWR | O_NOCTTY | O_CLOEXEC )) == -1) return -1;
+    if (!grantpt( master ) && !unlockpt( master ) && !ptsname_r( master, name, sizeof(name) ) &&
+        (slave = open( name, O_RDWR | O_NOCTTY | O_CLOEXEC )) != -1)
+    {
+        if (!wine_server_fd_to_handle( master, GENERIC_READ | GENERIC_WRITE | SYNCHRONIZE, 0, &handle ))
+        {
+            h = wine_server_obj_handle( handle );
+            if (sync_ioctl( console, IOCTL_CONDRV_ATTACH_PTY, &h, sizeof(h), NULL, 0 ))
+            {
+                close( slave );
+                slave = -1;
+            }
+            NtClose( handle );
+        }
+        else
+        {
+            close( slave );
+            slave = -1;
+        }
+    }
+    close( master );
+    return slave;
+#else
+    return -1;
+#endif
+}
