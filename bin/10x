#!/usr/bin/env bash
# Launch 10x Editor (Windows) through Wine's native Wayland driver.
#
#   10x [files...]   open 10x
#   10x --prewarm    boot the prefix and keep it running (10x-prewarm.service),
#                    as Windows' session is up before any program starts
#   10x --stop       shut the prefix down

wine_bin=/opt/10x-linux/wine/bin
lib=/usr/lib/10x-linux
share=/usr/share/10x-linux
export WINEPREFIX="${XDG_DATA_HOME:-$HOME/.local/share}/wineprefixes/10x"
export WINEDEBUG=${WINEDEBUG:--all}

install_dir="$WINEPREFIX/drive_c/Program Files/PureDevSoftware/10x"
exe='C:\Program Files\PureDevSoftware\10x\10x.exe'
if [[ ! -f "$install_dir/10x.exe" ]]; then
    msg="10x isn't set up for this user yet: run 10x-setup with your 10xInstaller.exe."
    echo "$msg" >&2; notify-send -a 10x "10x" "$msg" 2>/dev/null
    exit 1
fi

# Programs 10x runs by name (its terminal's `bash`) are looked up in Linux's
# PATH too, as Windows looks them up in its own; Wine runs them natively.
winepath=
IFS=: read -ra dirs <<< "$PATH"
for d in "${dirs[@]}"; do [[ "$d" == /* ]] && winepath+="${winepath:+;}Z:${d//\//\\}"; done
export WINEPATH="${WINEPATH:+$WINEPATH;}$winepath"
export PATH="$wine_bin:$PATH"

if [[ "$1" == --stop ]]; then
    exec wineserver -k
fi

# No menu entries from Wine. No USB, gamepad or Bluetooth passthrough: an
# editor never uses them, and their drivers poll in the background (~4% CPU).
export WINEDLLOVERRIDES="winemenubuilder.exe=d;winebus.sys=d;wineusb.sys=d;winebth.sys=d"
export DXVK_LOG_LEVEL=none

while read -r key value; do
    [[ "$key" == gpu ]] && gpu=$value
done < <("$lib/compositor-info" 2>/dev/null)

# Render on the GPU the compositor displays with, as native Wayland programs
# do, and load only that GPU's Vulkan and EGL drivers: another GPU's are read
# and initialised at every start, and holding them open keeps it awake.
sys=/sys/dev/char/$gpu/device
if [[ -n "$gpu" && -r "$sys/vendor" ]]; then
    export MESA_VK_DEVICE_SELECT="$(sed 's/^0x//' "$sys/vendor"):$(sed 's/^0x//' "$sys/device")!"
    case "$(basename "$(readlink "$sys/driver")")" in
        i915|xe) icds=(intel_icd intel_hasvk_icd) egl=50_mesa ;;
        amdgpu|radeon) icds=(radeon_icd) egl=50_mesa ;;
        nouveau) icds=(nouveau_icd) egl=50_mesa ;;
        nvidia) icds=(nvidia_icd) egl=10_nvidia ;;
        *) icds=() egl= ;;
    esac
    files=()
    for icd in "${icds[@]}"; do
        for f in /usr/share/vulkan/icd.d/"$icd".json /usr/share/vulkan/icd.d/"$icd".*.json; do
            [[ -f "$f" ]] && files+=("$f")
        done
    done
    if (( ${#files[@]} )); then
        export VK_DRIVER_FILES=$(IFS=:; echo "${files[*]}")
    fi
    [[ -n "$egl" && -f /usr/share/glvnd/egl_vendor.d/$egl.json ]] &&
        export __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/$egl.json
fi

# After an update of this package the prefix gets updated (wine.inf's time
# differs from the prefix's record). Do it before the session starts, without a
# display: Wine's graphical "configuration is being updated" run can hang.
# Wine writes its .update-timestamp when an update starts, so an update that
# was interrupted (e.g. its service timed out) would count as done: completion
# is recorded separately, once the prefix has settled.
update_prefix() {
    local inf_time done_file="$WINEPREFIX/.10x-updated"
    [[ "$(head -c 7 "$WINEPREFIX/.update-timestamp" 2>/dev/null)" == disable ]] && return
    inf_time=$(stat -c %Y "$wine_bin/../share/wine/wine.inf")
    [[ "$(cat "$done_file" 2>/dev/null)" == "$inf_time" ]] && return
    env -u WAYLAND_DISPLAY -u DISPLAY wineboot -u > /dev/null 2>&1
    wineserver -w && echo "$inf_time" > "$done_file"
}

# 10x can hang after its window closes: its log says "Exiting..." but the
# process stays. It then holds the session (an updated Wine can't replace it)
# and takes over the next start (a new 10x hands its files to the running one),
# so 10x won't open until it's killed. A 10x that began exiting over 10 seconds
# ago is ended. Its log is the one whose last "App Start" is when it started
# (a second instance writes 10x_1.log).
end_hung_exit() {
    local pids pid started log line start exiting t
    pids=($(pgrep -f 'PureDevSoftware.10x.10x\.exe'))
    (( ${#pids[@]} == 1 )) || return
    pid=${pids[0]}
    tr '\0' '\n' < /proc/$pid/environ 2>/dev/null | grep -qxF "WINEPREFIX=$WINEPREFIX" || return
    started=$(date -d "$(ps -o lstart= -p "$pid")" +%s 2>/dev/null) || return
    for log in "$WINEPREFIX/drive_c/users/$USER/AppData/Roaming/10x"/10x{,_*}.log; do
        [[ -f "$log" ]] || continue
        # "dd/mm/yyyy HH:MM:SS" of the last App Start, and of the first Exiting... after it
        line=$(awk -F': ' '
            /--------------- App Start/ { s = $1; e = "" }
            /: Exiting\.\.\.\r?$/ && s != "" && e == "" { e = $1 }
            END { print s "|" e }' "$log")
        start=${line%%|*} exiting=${line#*|}
        [[ -n "$start" ]] || continue
        t=$(date -d "${start:6:4}-${start:3:2}-${start:0:2} ${start:11:8}" +%s 2>/dev/null) || continue
        (( t - started >= -5 && t - started <= 60 )) || continue
        [[ -n "$exiting" ]] || return
        t=$(date -d "${exiting:6:4}-${exiting:3:2}-${exiting:0:2} ${exiting:11:8}" +%s 2>/dev/null) || return
        (( $(date +%s) - t > 10 )) || return
        kill -9 "$pid" 2>/dev/null
        while kill -0 "$pid" 2>/dev/null; do sleep 0.1; done
        return
    done
}

# Which Wine build the running session was started with (by --prewarm).
run_stamp="${XDG_RUNTIME_DIR:-/tmp}/10x-wineserver"

if [[ "$1" == --prewarm ]]; then
    update_prefix
    # Keep the server up forever, boot the prefix's services, and hold the
    # desktop process open (Wine otherwise stops it when no program is left).
    # hold-desktop.exe says when the desktop is up, which tells systemd the
    # session is ready (Type=notify): programs started later see its
    # displays, e.g. the primary monitor's DPI as the system DPI.
    stat -L -c %d:%i "$wine_bin/wineserver" > "$run_stamp"
    wineserver -p
    wine "$share/hold-desktop.exe" 2>/dev/null |
        { read -r && systemd-notify --ready; cat > /dev/null; }
    exit
fi

end_hung_exit

# The prefix's server must be this package's Wine: after an update of the
# package the running one is the old build, which refuses the new client.
if [[ "$(cat "$run_stamp" 2>/dev/null)" != "$(stat -L -c %d:%i "$wine_bin/wineserver")" ]]; then
    for p in $(pgrep -x wineserver); do
        tr '\0' '\n' < /proc/$p/environ 2>/dev/null | grep -qxF "WINEPREFIX=$WINEPREFIX" || continue
        [[ "$(readlink /proc/$p/exe)" == "$(readlink -f "$wine_bin/wineserver")" ]] && continue
        if pgrep -f 'PureDevSoftware.10x.10x\.exe' > /dev/null; then
            msg="10x was updated. Close 10x and open it again to use the new version."
            echo "$msg" >&2; notify-send -a 10x "10x" "$msg" 2>/dev/null
            exit 1
        fi
        systemctl --user stop 10x-prewarm.service 2>/dev/null
        wineserver -k 2>/dev/null
    done
fi
# Start the session if it isn't up; returns once it is.
if ! systemctl --user is-active -q 10x-prewarm.service; then
    update_prefix
    systemctl --user start 10x-prewarm.service 2>/dev/null
fi

# 10x draws its own title bar: its window buttons are deleted, the window
# manager handles those actions (an edited layout and a fix in 10x.exe, redone
# whenever either file changes; see titlebar.py). The stamp check is done here
# so an unchanged 10x costs no Python start-up.
tb_stamp_file="$WINEPREFIX/.10x-titlebar"
tb_stamp="$(stat -c '%s %Y' "$install_dir/10x.data" 2>/dev/null) $(stat -c '%s %Y' "$install_dir/10x.exe" 2>/dev/null) $(stat -c %Y "$share/titlebar.py")"
tb_prev=$(cat "$tb_stamp_file" 2>/dev/null)
if ! [[ ( "$tb_prev" == "$tb_stamp" && -f "$install_dir/UI/10X.ui_proj_bin" ) ||
        "$tb_prev" == "stock $tb_stamp" ]]; then
    if ! python3 -I "$share/titlebar.py" "$install_dir" "$tb_stamp_file" 2>/dev/null; then
        notify-send -a 10x "10x" "This 10x version is unfamiliar, so its own title-bar buttons are back." 2>/dev/null
    fi
fi

# Translate Linux paths to Windows paths (Z: maps to /) so "Open with" and
# `10x some/file.cpp` work like they do on Windows. Options pass through, as
# do Windows paths; a path that doesn't exist yet (a new file) is translated
# if its directory exists. Symlinks are kept as typed.
args=()
for a in "$@"; do
    if [[ "$a" != -* && "$a" != *\\* && "$a" != *:* &&
          ( -e "$a" || -d "$(dirname -- "$a")" ) ]]; then
        p=$(realpath -s -m -- "$a")
        args+=("Z:${p//\//\\}")
    else
        args+=("$a")
    fi
done

# Started like the desktop starts programs: the launcher's stdin and stdout
# aren't 10x's (they'd be its terminals' input and output otherwise).
export WINEDESKTOPSTART=1
exec wine "$exe" "${args[@]}"
